---
/**
 * SZABLON PODSTRONY USŁUGI - następca komponentu `ServicePage.jsx`.
 *
 * Dziewięć podstron dzieli ten układ i różni się wyłącznie treścią
 * z `src/content/uslugi/`. Podstrona w `src/pages/` podaje klucz oraz
 * tytuł i opis dla wyszukiwarki - i nic poza tym.
 *
 * Tabela cennika bierze się z `src/content/cennik.json` PO KLUCZU TRASY tej
 * podstrony - podstrona nie trzyma kwot i nie wskazuje ich osobnym polem.
 * Klucz jest jeden i ten sam w `routes.ts`, w cenniku i w formularzu korekty,
 * więc klient widzi w edytorze dokładnie tę tabelę, którą ma na ekranie.
 *
 * ┌── PRZEJŚCIE Z 19.09.2026 ──────────────────────────────────────────┐
 * │ Ten szablon miał WŁASNĄ sekcję główną na jasnym tle, własny układ    │
 * │ „Dlaczego my" i własny cennik - mimo że huby miały dokładnie te same │
 * │ bloki. Efekt: dziewięć podstron wyglądało inaczej niż trzy nad nimi. │
 * │ Wszystkie trzy bloki są teraz wspólnymi komponentami, a tutaj zostaje│
 * │ to, co jest właściwe wyłącznie podstronie rodzaju usługi: parametry  │
 * │ i galeria.                                                           │
 * └──────────────────────────────────────────────────────────────────────┘
 */
import Podstrona from '../../layouts/Podstrona.astro'
import { wpis } from '../../lib/tresc'
import { pozycjeStrony } from '../../lib/cennik'
import { trasa } from '../../config/routes'
import Okruszki from '../ui/Okruszki.astro'
import EtykietaSekcji from '../ui/EtykietaSekcji.astro'
import Przycisk from '../ui/Przycisk.astro'
import LinkSekcji from '../ui/LinkSekcji.astro'
import Odslon from '../ui/Odslon.astro'
import SekcjaFaq from '../ui/SekcjaFaq.astro'
import SekcjaHero from '../ui/SekcjaHero.astro'
import SekcjaDlaczegoMy from './SekcjaDlaczegoMy.astro'
import SekcjaCennika from './SekcjaCennika.astro'
import GaleriaSiatka from '../ui/GaleriaSiatka.astro'
import GaleriaKaruzela from '../ui/GaleriaKaruzela.astro'
import Ikona from '../icons/Ikona.astro'
import Foto from '../media/Foto.astro'
import type { NazwaIkony } from '../icons/ikony'

interface Props {
  klucz: string
}
const { klucz } = Astro.props

const dane = await wpis('uslugi', klucz)
const cennik = pozycjeStrony(klucz)

/**
 * Kadrowanie zdjęcia w sekcji głównej. Wartości z `pozycjaFoto` muszą stać
 * tutaj DOSŁOWNIE - Tailwind generuje klasę tylko wtedy, gdy zobaczy ją
 * w kodzie. Klasa zamiast atrybutu `style`, bo CSP nie przepuszcza stylów
 * w znaczniku.
 */
const POZYCJE: Record<string, string> = {
  '0 40%': 'object-[0_40%]',
  '0% 0%': 'object-[0%_0%]',
  '0% 75%': 'object-[0%_75%]',
}
const pozycjaFoto = dane.pozycjaFoto ? POZYCJE[dane.pozycjaFoto] : undefined

const okruszki = [
  { etykieta: 'Strona główna', sciezka: trasa('glowna') },
  { etykieta: dane.okruszekNadrzedny.etykieta, sciezka: trasa(dane.okruszekNadrzedny.trasa) },
  { etykieta: dane.okruszek },
]

const tytulGalerii = `Nasze ${dane.nazwaMnoga}`
---

<Podstrona tytul={dane.meta.tytul} opis={dane.meta.opis}>
  <Okruszki pozycje={okruszki} />

  <SekcjaHero
    etykieta={dane.etykieta}
    tytul={dane.tytul}
    podtytul={dane.podtytul}
    opis={dane.wstep}
    foto={dane.fotoHero}
  >
    <Fragment slot="akcje">
      <Przycisk href="/wycena/" rozmiar="lg" ikona="receipt-text">Zapytaj o wycenę</Przycisk>
      <Przycisk href="#sekcja-cennik" wariant="secondary" rozmiar="lg" ikona="banknote">Cennik usługi</Przycisk>
    </Fragment>

    <Foto
      slot="obok"
      klucz={dane.fotoHero}
      alt={dane.tytul}
      class:list={[
        'w-full h-[340px] object-cover rounded-2xl shadow-2xl shadow-black/50',
        pozycjaFoto,
      ]}
    />
  </SekcjaHero>

  {/* ═══ PARAMETRY ═══════════════════════════════════════ */}
  <section class="tlo-siatka bg-brand-bg py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <div class="mb-6">
          <EtykietaSekcji>Parametry</EtykietaSekcji>
          <h2 class="font-display text-2xl lg:text-3xl font-bold text-brand-text mt-2">
            Dlaczego {dane.nazwaPojedyncza}?
          </h2>
        </div>
      </Odslon>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          dane.cechy.map((cecha, i) => (
            <Odslon zwloka={i * 80}>
              <div class="bg-brand-card rounded-xl border border-brand-border px-3 py-5 lg:px-4 lg:py-6 hover:shadow-lg hover:shadow-black/5 hover:border-brand-olive/30 transition-all duration-300 h-full">
                <div class="flex items-center gap-3 mb-2">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-olive/15 text-brand-olive-text">
                    <Ikona nazwa={cecha.ikona as NazwaIkony} rozmiar={19} />
                  </span>
                  <h3 class="font-display text-base font-bold text-brand-text">{cecha.tytul}</h3>
                </div>
                <p class="text-sm text-brand-text-light leading-relaxed">{cecha.opis}</p>
              </div>
            </Odslon>
          ))
        }
      </div>
    </div>
  </section>

  <SekcjaDlaczegoMy
    tytulGorny={dane.tresc.tytul1}
    foto={dane.fotoHero}
    fotoAlt={`${dane.tytul} - realizacja BramBruk`}
    kroki={{ tytul: dane.kroki.tytul, wstep: dane.kroki.wstep, lista: dane.kroki.lista }}
    bloki={[
      { tytul: dane.tresc.tytul2, tekst: dane.tresc.tekst2 },
      { tytul: dane.tresc.tytul3, tekst: dane.tresc.tekst3 },
      { tytul: 'Sprzęt, na którym pracujemy', tekst: dane.sprzet },
    ]}
    tlo="bg-brand-section"
  >
    <p slot="gorny">{dane.tresc.tekst1}</p>
  </SekcjaDlaczegoMy>

  <SekcjaCennika
    id="sekcja-cennik"
    etykieta="Orientacyjny cennik"
    tytul={`Ile kosztuje ${dane.nazwaPojedyncza}?`}
    wstep="Cennik pokazuje widełki cenowe, a nie konkretne ceny, ponieważ ostateczny koszt zależy od kilku rzeczy, których nie widać na etapie zapytania:"
    czynniki={dane.cennikCzynniki}
    pozycje={cennik}
  />

  {/* ═══ REALIZACJE ══════════════════════════════════════ */}
  <section class="bg-brand-section py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-6">
          <div>
            <EtykietaSekcji>Realizacje</EtykietaSekcji>
            <h2 class="font-display text-xl lg:text-2xl font-bold text-brand-text mt-2">{tytulGalerii}</h2>
          </div>
          <LinkSekcji href="/realizacje/" ikona="images" miejsce="naglowek">Zobacz wszystkie realizacje</LinkSekcji>
        </div>
      </Odslon>

      <GaleriaSiatka pozycje={dane.galeria} class="hidden md:grid" />
      <GaleriaKaruzela pozycje={dane.galeria} class="md:hidden" />

      <LinkSekcji href="/realizacje/" ikona="images">Zobacz wszystkie realizacje</LinkSekcji>
    </div>
  </section>

  <SekcjaFaq
    etykieta={`FAQ - ${dane.etykieta}`}
    tytul={`Pytania o ${dane.nazwaMnoga}`}
    pytania={dane.faq}
    tlo="bg-brand-bg"
  />
</Podstrona>
