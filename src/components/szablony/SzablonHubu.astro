---
/**
 * SZABLON HUBA KATEGORII - następca komponentu `ServiceHub.jsx`.
 *
 * Trzy podstrony (/ogrodzenia/, /brukarstwo/, /budownictwo/) dzielą ten
 * układ i różnią się wyłącznie treścią z `src/content/huby/`.
 *
 * Tabela „orientacyjne ceny" NIE MA WŁASNYCH KWOT: bierze je z
 * `src/content/cennik.json` PO KLUCZU TRASY tej podstrony - tym samym, który
 * stoi w `src/config/routes.ts` i w formularzu korekty. Rekord treści nie ma
 * już pola `cennik`: wskazywanie cennika osobnym polem znaczyło, że dwa
 * pliki muszą się zgadzać po identyfikatorze, którego nic nie pilnowało.
 *
 * Hub pokazuje to, co WSPÓLNE dla co najmniej dwóch usług w tej kategorii
 * albo zbiorcze - reszta stoi na podstronach usług.
 *
 * ┌── CO TU ZOSTAŁO PO PRZEJŚCIU Z 19.09.2026 ─────────────────────────┐
 * │ Sekcja główna, sekcja „Dlaczego my" i cennik wyprowadziły się do     │
 * │ wspólnych komponentów (`SekcjaHero`, `SekcjaDlaczegoMy`,             │
 * │ `SekcjaCennika`), bo dokładnie te same bloki stoją na podstronach    │
 * │ rodzajów usług. Trzymanie dwóch kopii tego samego układu było        │
 * │ powodem, dla którego podstrony z jednej grupy wyglądały inaczej      │
 * │ mimo że miały wyglądać tak samo.                                     │
 * │                                                                      │
 * │ Tutaj zostaje to, co jest właściwe hubowi: siatka kart rodzajów      │
 * │ usług i galeria realizacji z tej kategorii.                          │
 * └──────────────────────────────────────────────────────────────────────┘
 */
import Podstrona from '../../layouts/Podstrona.astro'
import { wpis } from '../../lib/tresc'
import { pozycjeStrony, tytulPrzegladu } from '../../lib/cennik'
import { trasa } from '../../config/routes'
import Okruszki from '../ui/Okruszki.astro'
import EtykietaSekcji from '../ui/EtykietaSekcji.astro'
import Przycisk from '../ui/Przycisk.astro'
import LinkSekcji from '../ui/LinkSekcji.astro'
import Odslon from '../ui/Odslon.astro'
import KartaUslugi from '../ui/KartaUslugi.astro'
import SekcjaFaq from '../ui/SekcjaFaq.astro'
import SekcjaHero from '../ui/SekcjaHero.astro'
import SekcjaDlaczegoMy from './SekcjaDlaczegoMy.astro'
import SekcjaCennika from './SekcjaCennika.astro'
import GaleriaSiatka from '../ui/GaleriaSiatka.astro'
import GaleriaKaruzela from '../ui/GaleriaKaruzela.astro'
import Foto from '../media/Foto.astro'

interface Props {
  klucz: string
}
const { klucz } = Astro.props

const dane = await wpis('huby', klucz)

const { zasieg, metodyka, sprzet } = dane.tresc
---

<Podstrona tytul={dane.meta.tytul} opis={dane.meta.opis}>
  <Okruszki pozycje={[{ etykieta: 'Strona główna', sciezka: trasa('glowna') }, { etykieta: dane.okruszek }]} />

  <SekcjaHero
    etykieta={dane.etykieta}
    tytul={dane.tytulHero}
    podtytul={dane.podtytulHero}
    opis={dane.opisHero}
    foto={dane.fotoHero}
  >
    <Fragment slot="akcje">
      <Przycisk href="/wycena/" rozmiar="lg" ikona="receipt-text">Bezpłatna wycena</Przycisk>
      <Przycisk href="/realizacje/" wariant="secondary" rozmiar="lg" ikona="images">Nasze realizacje</Przycisk>
    </Fragment>

    <Foto
      slot="obok"
      klucz={dane.fotoHeroObok}
      class="w-full h-[340px] object-cover rounded-2xl shadow-2xl shadow-black/50"
    />
  </SekcjaHero>

  {/* ═══ CO OFERUJEMY ════════════════════════════════════ */}
  <section class="tlo-siatka bg-brand-section py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-6">
          <div>
            <EtykietaSekcji>Co oferujemy</EtykietaSekcji>
            <h2 class="font-display text-2xl lg:text-4xl font-bold text-brand-text mt-2">{dane.tytulSekcji}</h2>
          </div>
          <LinkSekcji href="/uslugi/" ikona="banknote" miejsce="naglowek">Wszystkie usługi i cennik</LinkSekcji>
        </div>
      </Odslon>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          dane.uslugi.map((usluga, i) => (
            <Odslon wariant="up" zwloka={i * 30}>
              <KartaUslugi
                tytul={usluga.tytul}
                opis={usluga.opis}
                foto={usluga.foto}
                href={usluga.trasa ? trasa(usluga.trasa) : trasa('wycena')}
                cta={usluga.trasa ? 'Zobacz szczegóły' : 'Zapytaj o wycenę'}
              />
            </Odslon>
          ))
        }
      </div>

      <LinkSekcji href="/uslugi/" ikona="banknote">Wszystkie usługi i cennik</LinkSekcji>
    </div>
  </section>

  <SekcjaDlaczegoMy
    tytulGorny={zasieg.tytul}
    foto={dane.tresc.fotoObok}
    fotoAlt={dane.tresc.fotoObokAlt}
    kroki={{ tytul: metodyka.tytul, wstep: metodyka.wstep, lista: metodyka.kroki }}
    dodatki={{ tytul: metodyka.tytulDodatkow, wstep: metodyka.wstepDodatkow, lista: metodyka.dodatki }}
    bloki={[{ tytul: sprzet.tytul, tekst: sprzet.tekst }]}
    tlo="bg-brand-bg"
  >
    <p slot="gorny">
      {zasieg.tekst}{' '}
      {
        zasieg.miasta.map((miasto, i) => (
          <>
            <strong class="font-semibold text-brand-text">{miasto}</strong>
            {i < zasieg.miasta.length - 1 ? ', ' : ' '}
          </>
        ))
      }
      {zasieg.domkniecie}
    </p>
  </SekcjaDlaczegoMy>

  <SekcjaCennika
    etykieta="Orientacyjne ceny"
    tytul={tytulPrzegladu(klucz)}
    wstep={dane.cennikOpis.wstep}
    czynniki={dane.cennikOpis.czynniki}
    pozycje={pozycjeStrony(klucz)}
  />

  {/* ═══ REALIZACJE ══════════════════════════════════════ */}
  <section class="bg-brand-section py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-6">
          <div>
            <EtykietaSekcji>Realizacje</EtykietaSekcji>
            <h2 class="font-display text-2xl lg:text-3xl font-bold text-brand-text mt-2">{dane.tytulGalerii}</h2>
          </div>
          <LinkSekcji href="/realizacje/" ikona="images" miejsce="naglowek">Zobacz wszystkie realizacje</LinkSekcji>
        </div>
      </Odslon>

      <GaleriaSiatka pozycje={dane.galeria} class="hidden md:grid" />
      <GaleriaKaruzela pozycje={dane.galeria} class="md:hidden" />

      <LinkSekcji href="/realizacje/" ikona="images">Zobacz wszystkie realizacje</LinkSekcji>
    </div>
  </section>

  {/* FAQ na `brand-bg`: jaśniejsze niż cennik nad nim i inne niż sekcja
      realizacji, więc czyta się jako osobny blok, a nie ciąg dalszy. */}
  <SekcjaFaq etykieta={dane.etykietaFaq} tytul={dane.tytulFaq} pytania={dane.faq} tlo="bg-brand-bg" />
</Podstrona>
