---
/**
 * SEKCJA CENNIKA - ten sam blok na trzech hubach i dziewięciu podstronach usług.
 *
 * Ciemne tło i dwie kolumny: po lewej powód, dla którego to są WIDEŁKI,
 * po prawej same liczby. Wcześniej ten sam układ był przepisany w dwóch
 * szablonach, więc każda poprawka wymagała dwóch identycznych zmian.
 *
 * Etykieta stoi nad kolumnami, na pełną szerokość - zasada obowiązująca
 * w całym serwisie: prawa kolumna nie może zaczynać się wyżej niż lewa.
 *
 * Faktura tła (`tlo-ciemne`): poświata w prawym dolnym rogu i zagęszczona
 * siatka punktów w lewym górnym. Liczby i mechanizm: `styles/components/tlo.css`.
 *
 * TRZY KOLUMNY KWOT: materiał, robocizna i razem. Cena całkowita nie stoi
 * w pliku treści - liczy ją `src/lib/cennik.ts` z dwóch pierwszych, więc
 * wiersz nie ma jak się rozjechać sam ze sobą. Przy wąskiej tabeli kolumny
 * składowych chowają się pod nazwę usługi: „Razem" zostaje zawsze, bo to
 * jedyna liczba, po którą ktoś tu przyszedł. Nagłówek „Materiał"
 * i „Robocizna" znika wtedy razem z kolumnami, więc jego rolę przejmuje
 * druga linia nagłówka pierwszej kolumny („materiał + robocizna") - bez niej
 * dwie kwoty pod nazwą pozycji nie mówiły, co znaczą. Ta linia dziedziczy
 * `neutral-400` z wiersza nagłówka (6,61:1 na `brand-dark`); własny kolor
 * `neutral-500` spadłby do 3,52:1.
 *
 * ⚠️ PRZEŁĄCZA ZAPYTANIE O KONTENER (`@container` + wariant `@lg`), nie punkt
 * łamania okna. Szerokość tabeli nie wynika z szerokości ekranu, tylko z tego,
 * czy sekcja stoi w jednej kolumnie, czy w dwóch: przy oknie 1024 px tabela
 * dostaje 440 px, a przy 800 px - całe 720 px. Punkt łamania okna pokazywał
 * przez to cztery kolumny tam, gdzie mieściły się trzy, a `overflow-hidden`
 * ucinał kolumnę „Razem" - czyli jedyną istotną. Próg 32 rem bierze się
 * z pomiaru: najszersza tabela (budownictwo) potrzebuje 478 px, a docelowa
 * kolumna ma 568 px.
 *
 * Pozycja wyliczana z innej („podjazd 40 m²") nie ma rozbicia - jej kwota
 * bierze się z metrażu razy stawka, a nie z własnego materiału i montażu.
 *
 * Para przycisków jest przenoszona (`Przenoszony`): po zejściu do jednej
 * kolumny ląduje POD tabelą widełek. Spełnia obie przesłanki reguły - nad nią
 * stoi neutralna lista czynników, która na przyciski nie wskazuje, a to
 * właśnie tabela nadaje sens przyciskowi „Bezpłatna wycena": kto nie zobaczył
 * widełek, nie ma po co prosić o wycenę.
 */
import EtykietaSekcji from "../ui/EtykietaSekcji.astro";
import Odslon from "../ui/Odslon.astro";
import Przenoszony from "../ui/Przenoszony.astro";
import PrzyciskiWyceny from "../ui/PrzyciskiWyceny.astro";
import Ikona from "../icons/Ikona.astro";
import type { WierszCennika } from "../../lib/cennik";

interface Props {
  etykieta: string;
  tytul: string;
  wstep: string;
  czynniki: readonly string[];
  pozycje: readonly WierszCennika[];
  id?: string;
}
const { etykieta, tytul, wstep, czynniki, pozycje, id } = Astro.props;

/* Odsyłanie do cennika ze środka cennika nie miałoby sensu - drugi przycisk
   prowadzi stąd do listy usług. Stała, bo obie kopie pary muszą dostać to
   samo; rozjechanie się ich to pierwsza rzecz, która przechodzi bez echa. */
const INNE_USLUGI = {
  href: "/uslugi/",
  ikona: "banknote",
  etykieta: "Inne usługi",
} as const;
---

<section class="tlo-ciemne bg-brand-dark py-14 lg:py-20" id={id}>
  <div class="max-w-7xl mx-auto px-5 lg:px-10">
    <Odslon>
      <EtykietaSekcji wariant="ciemne">{etykieta}</EtykietaSekcji>
    </Odslon>

    <div
      class="mt-2 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start"
    >
      <Odslon wariant="left">
        <div class="lg:sticky lg:top-[calc(var(--naglowek-wysokosc)+2rem)]">
          <h2
            class="font-display text-2xl lg:text-3xl font-bold text-white mb-4"
          >
            {tytul}
          </h2>
          <p class="text-neutral-400 leading-relaxed mb-5">{wstep}</p>

          <ul class="space-y-2.5 lg:mb-5">
            {
              czynniki.map((czynnik) => (
                <li class="flex gap-3 text-sm text-brand-text-xlight leading-relaxed">
                  <Ikona
                    nazwa="check-circle-2"
                    rozmiar={17}
                    class="mt-px shrink-0 text-brand-olive"
                  />
                  <span>{czynnik}</span>
                </li>
              ))
            }
          </ul>

          <Przenoszony miejsce="kolumna">
            <PrzyciskiWyceny ciemne drugi={INNE_USLUGI} />
          </Przenoszony>
        </div>
      </Odslon>

      <Odslon wariant="right">
        <div>
          <div
            class="@container overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]"
          >
            <table class="w-full text-sm">
              <thead>
                <tr
                  class="border-b border-white/10 bg-white/[0.04] text-[10px] uppercase tracking-widest text-neutral-400"
                >
                  <th class="px-3 py-2.5 text-left font-semibold @lg:px-4">
                    Pozycja
                    <span
                      class="block font-normal normal-case tracking-normal @lg:hidden"
                      >materiał + robocizna</span
                    >
                  </th>
                  <th
                    class="hidden px-2 py-2.5 text-right font-semibold @lg:table-cell"
                    >Materiał</th
                  >
                  <th
                    class="hidden px-2 py-2.5 text-right font-semibold @lg:table-cell"
                    >Robocizna</th
                  >
                  <th class="px-3 py-2.5 text-right font-semibold @lg:px-4"
                    >Razem</th
                  >
                </tr>
              </thead>
              <tbody>
                {
                  pozycje.map((wiersz, i) => (
                    <tr
                      class:list={[
                        i !== pozycje.length - 1 && "border-b border-white/10",
                      ]}
                    >
                      <td class="px-3 py-3 align-top @lg:px-4">
                        <span class="text-brand-text-xlight">
                          {wiersz.usluga}
                        </span>
                        <span class="mt-1 block text-xs text-neutral-400 @lg:hidden">
                          {wiersz.material
                            ? `${wiersz.material} + ${wiersz.montaz}`
                            : "z metrażu razy stawka"}
                        </span>
                      </td>
                      <td class="hidden whitespace-nowrap px-2 py-3 text-right align-top text-xs text-neutral-400 @lg:table-cell">
                        {wiersz.material ?? "—"}
                      </td>
                      <td class="hidden whitespace-nowrap px-2 py-3 text-right align-top text-xs text-neutral-400 @lg:table-cell">
                        {wiersz.montaz ?? "—"}
                      </td>
                      <td class="whitespace-nowrap px-3 py-3 text-right align-top text-sm font-bold text-brand-olive @lg:px-4">
                        {wiersz.razem}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p
            class="mt-4 flex items-start gap-2 text-xs text-neutral-400 leading-relaxed"
          >
            <Ikona nazwa="alert-circle" rozmiar={14} class="mt-0.5 shrink-0" />
            <span>
              Kolumna „Razem" to materiał plus robocizna - transport, dojazd i
              drobny osprzęt mieszczą się w tych kwotach. Ceny orientacyjne,
              aktualne na 2026 r. Nie stanowią oferty w rozumieniu Kodeksu
              cywilnego - dokładną kwotę podajemy po bezpłatnej wizji lokalnej.
            </span>
          </p>
        </div>
      </Odslon>

      <Przenoszony miejsce="pod">
        <PrzyciskiWyceny ciemne drugi={INNE_USLUGI} />
      </Przenoszony>
    </div>
  </div>
</section>
