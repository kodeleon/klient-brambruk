---
/**
 * SEKCJA CENNIKA - ten sam blok na trzech hubach i dziewięciu podstronach usług.
 *
 * Ciemne tło i dwie kolumny: po lewej powód, dla którego to są WIDEŁKI,
 * po prawej same liczby. Wcześniej ten sam układ był przepisany w dwóch
 * szablonach, więc każda poprawka wymagała dwóch identycznych zmian.
 *
 * Etykieta stoi nad kolumnami, na pełną szerokość - zasada obowiązująca
 * w całym serwisie: prawa kolumna nie może zaczynać się wyżej niż lewa.
 *
 * Faktura tła (`tlo-ciemne`): poświata w prawym dolnym rogu i zagęszczona
 * siatka punktów w lewym górnym. Liczby i mechanizm: `styles/components/tlo.css`.
 *
 * Para przycisków jest przenoszona (`Przenoszony`): po zejściu do jednej
 * kolumny ląduje POD tabelą widełek. Spełnia obie przesłanki reguły - nad nią
 * stoi neutralna lista czynników, która na przyciski nie wskazuje, a to
 * właśnie tabela nadaje sens przyciskowi „Bezpłatna wycena": kto nie zobaczył
 * widełek, nie ma po co prosić o wycenę.
 */
import EtykietaSekcji from "../ui/EtykietaSekcji.astro";
import Odslon from "../ui/Odslon.astro";
import Przenoszony from "../ui/Przenoszony.astro";
import PrzyciskiWyceny from "../ui/PrzyciskiWyceny.astro";
import Ikona from "../icons/Ikona.astro";

interface Props {
  etykieta: string;
  tytul: string;
  wstep: string;
  czynniki: readonly string[];
  pozycje: readonly { usluga: string; cena: string }[];
  id?: string;
}
const { etykieta, tytul, wstep, czynniki, pozycje, id } = Astro.props;

/* Odsyłanie do cennika ze środka cennika nie miałoby sensu - drugi przycisk
   prowadzi stąd do listy usług. Stała, bo obie kopie pary muszą dostać to
   samo; rozjechanie się ich to pierwsza rzecz, która przechodzi bez echa. */
const INNE_USLUGI = {
  href: "/uslugi/",
  ikona: "banknote",
  etykieta: "Inne usługi",
} as const;
---

<section class="tlo-ciemne bg-brand-dark py-14 lg:py-20" id={id}>
  <div class="max-w-7xl mx-auto px-5 lg:px-10">
    <Odslon>
      <EtykietaSekcji wariant="ciemne">{etykieta}</EtykietaSekcji>
    </Odslon>

    <div
      class="mt-2 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start"
    >
      <Odslon wariant="left">
        <div class="lg:sticky lg:top-[calc(var(--naglowek-wysokosc)+2rem)]">
          <h2
            class="font-display text-2xl lg:text-3xl font-bold text-white mb-4"
          >
            {tytul}
          </h2>
          <p class="text-neutral-400 leading-relaxed mb-5">{wstep}</p>

          <ul class="space-y-2.5 lg:mb-5">
            {
              czynniki.map((czynnik) => (
                <li class="flex gap-3 text-sm text-brand-text-xlight leading-relaxed">
                  <Ikona
                    nazwa="check-circle-2"
                    rozmiar={17}
                    class="mt-px shrink-0 text-brand-olive"
                  />
                  <span>{czynnik}</span>
                </li>
              ))
            }
          </ul>

          <Przenoszony miejsce="kolumna">
            <PrzyciskiWyceny ciemne drugi={INNE_USLUGI} />
          </Przenoszony>
        </div>
      </Odslon>

      <Odslon wariant="right">
        <div>
          <div
            class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]"
          >
            {
              pozycje.map((wiersz, i) => (
                <div
                  class:list={[
                    "flex items-center justify-between gap-4 px-3 py-4 sm:px-4",
                    i !== pozycje.length - 1 && "border-b border-white/10",
                  ]}
                >
                  <span class="text-sm text-brand-text-xlight">
                    {wiersz.usluga}
                  </span>
                  <span class="text-sm font-bold text-brand-olive whitespace-nowrap">
                    {wiersz.cena}
                  </span>
                </div>
              ))
            }
          </div>

          <p
            class="mt-4 flex items-start gap-2 text-xs text-neutral-400 leading-relaxed"
          >
            <Ikona nazwa="alert-circle" rozmiar={14} class="mt-0.5 shrink-0" />
            <span>
              Ceny orientacyjne, aktualne na 2026 r. Nie stanowią oferty w
              rozumieniu Kodeksu cywilnego - dokładną kwotę podajemy po
              bezpłatnej wizji lokalnej.
            </span>
          </p>
        </div>
      </Odslon>

      <Przenoszony miejsce="pod">
        <PrzyciskiWyceny ciemne drugi={INNE_USLUGI} />
      </Przenoszony>
    </div>
  </div>
</section>
