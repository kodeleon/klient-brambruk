---
/**
 * PASEK STATYSTYK - odpowiednik `StatBar.jsx`.
 * Liczby biorą się z `src/content/`, nie z kodu komponentu. Lata na rynku
 * są LICZONE z roku założenia - przechowywana „6" starzała się co Nowy Rok.
 *
 * `kolumny` istnieje, bo ten sam pasek stoi raz na pełnej szerokości sekcji,
 * a raz w kolumnie o połowie tej szerokości. Cztery pozycje w wąskiej
 * kolumnie zlewają się w rząd liczb bez etykiet - stąd wariant dwukolumnowy.
 */
import firma from "../../content/firma.json";
import dowody from "../../content/dowody.json";

interface Props {
  /** 4 = jeden rząd na szerokiej sekcji, 2 = siatka 2x2 w wąskiej kolumnie. */
  kolumny?: 2 | 4;
  class?: string;
}
const { kolumny = 4, class: klasa = "" } = Astro.props;

const lata = new Date().getFullYear() - firma.rokZalozenia;

const pozycje = [
  { wartosc: String(lata), etykieta: "lat doświadczenia" },
  { wartosc: String(dowody.statystyki.miejscowosci), etykieta: "miejscowości" },
  { wartosc: dowody.statystyki.realizacje, etykieta: "realizacji" },
  { wartosc: dowody.fixly.ocena, etykieta: "ocena na Fixly" },
];

const SIATKA = {
  4: "grid grid-cols-2 lg:grid-cols-4 gap-4",
  2: "grid grid-cols-2 gap-4",
} as const;
---

<div class:list={[SIATKA[kolumny], klasa]}>
  {
    pozycje.map((p) => (
      <div>
        <div class="font-display text-3xl lg:text-4xl font-bold text-brand-sage-jasny">
          {p.wartosc}
        </div>
        <div class="text-xs text-brand-text-light mt-1">{p.etykieta}</div>
      </div>
    ))
  }
</div>
