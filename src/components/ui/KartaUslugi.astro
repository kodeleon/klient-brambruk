---
/**
 * KARTA USŁUGI - odpowiednik `ServiceCard.jsx`.
 *
 * Karta bez `href` renderuje `<div>` i nie pokazuje strzałki - tak jak
 * poprzednio (huby budownictwa mają karty bez podstron docelowych).
 * Odznaka z ceną wchodzi slotem `odznaka`.
 */
import Ikona from '../icons/Ikona.astro'
import Foto from '../media/Foto.astro'

interface Props {
  tytul: string
  opis: string
  /** Klucz zdjęcia z manifestu mediów. */
  foto: string
  href?: string
  class?: string
}
const { tytul, opis, foto, href, class: klasa = '' } = Astro.props

const klasy = `group block relative bg-brand-card rounded-2xl border border-brand-border/60 overflow-hidden shadow-sm shadow-black/[0.04] hover:shadow-md hover:shadow-black/[0.07] hover:border-brand-olive/20 transition-all duration-300 ${klasa}`
const Znacznik = href ? 'a' : 'div'
---

<Znacznik class={klasy} href={href}>
  <div class="img-hover aspect-[16/10] overflow-hidden">
    <Foto
      klucz={foto}
      alt={tytul}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-5 lg:p-6">
    <h3 class="font-display text-lg font-bold text-brand-text mb-1.5">{tytul}</h3>
    <p class="text-sm text-brand-text-light mb-4 leading-relaxed">{opis}</p>
    {
      href && (
        <span class="inline-flex items-center gap-1.5 text-brand-sage text-sm font-semibold group-hover:gap-2.5 transition-all duration-300">
          Zobacz szczegóły
          <Ikona nazwa="arrow-right" rozmiar={14} class="transition-transform group-hover:translate-x-1" />
        </span>
      )
    }
  </div>
  <slot name="odznaka" />
</Znacznik>
