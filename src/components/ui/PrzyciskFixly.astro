---
/**
 * ODNOŚNIK DO PROFILU NA FIXLY - odpowiednik `FixlyButton.jsx`.
 *
 * Logo Fixly leżało w WordPressie klienta (`/wp-content/uploads/2025/11/fixly.png`).
 * Do czasu wgrania pliku do `media/img/_raw/` stoi tu sam napis w kolorystyce
 * Fixly - patrz `MIGRACJA-braki.md`.
 */
import { fixly } from '../../config/dane'

interface Props {
  class?: string
}
const { class: klasa = '' } = Astro.props
---

<a
  href={fixly.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['inline-flex items-center rounded-full bg-fixly-main hover:opacity-90 transition h-6 px-2.5 pl-3', klasa]}
  aria-label="Zobacz profil na Fixly (otwiera się w nowej karcie)"
  title="Fixly"
>
  <span class="text-[11px] font-bold text-fixly-dark leading-none">Fixly</span>
</a>
