---
/**
 * ETYKIETA SEKCJI - odpowiednik `SectionLabel.jsx`.
 *
 * Nadtytuł nad nagłówkiem. Jest `<span>`, nie nagłówkiem, i tak ma zostać:
 * hierarchia nagłówków to struktura dokumentu, nie styl.
 *
 * ┌── KOLOR JEST WARIANTEM, NIE KLASĄ Z ZEWNĄTRZ ──────────────────────┐
 * │ Domyślny `brand-sage-jasny` jest odcieniem ze starego projektu,     │
 * │ przywróconym 19.09.2026 na wyraźną decyzję właściciela serwisu.     │
 * │ Na jasnym tle daje 2,44:1, czyli PONIŻEJ progu - rekompensatą jest  │
 * │ `font-extrabold` zamiast `font-bold`. Liczby: tabela w tokens.css.  │
 * │                                                                     │
 * │ Kusi, żeby podać `class="text-brand-olive"` i mieć spokój - ale      │
 * │ wtedy na elemencie stoją DWIE klasy koloru tekstu, a o wyniku       │
 * │ decyduje kolejność reguł w arkuszu, nie kolejność klas w znaczniku. │
 * │ Tailwind sortuje je po swojemu i wygrywał `brand-sage`, przez co    │
 * │ etykieta na ciemnym tle była nieczytelna mimo „poprawki".            │
 * │ Stąd `wariant`: jedna klasa koloru na element, zawsze.              │
 * └─────────────────────────────────────────────────────────────────────┘
 */
interface Props {
  /**
   * `jasne`  - na `brand-bg`, `brand-section`, `brand-card` (domyślnie)
   * `ciemne` - na `brand-dark`
   * `fixly`  - etykieta sekcji opinii, w kolorystyce Fixly, na jasnym tle
   */
  wariant?: "jasne" | "ciemne" | "fixly";
  class?: string;
}
const { wariant = "jasne", class: klasa = "" } = Astro.props;

const KOLORY = {
  jasne: "text-brand-sage-jasny",
  ciemne: "text-brand-olive",
  fixly: "text-fixly-ink",
} as const;
---

<span
  class:list={[
    "inline-block text-[11px] font-extrabold tracking-[2px] uppercase",
    KOLORY[wariant],
    klasa,
  ]}
>
  <slot />
</span>
