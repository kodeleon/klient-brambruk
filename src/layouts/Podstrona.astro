---
/**
 * UKŁAD PODSTRONY - jedyne miejsce, w którym powstaje <head>.
 *
 * Każda podstrona serwisu przechodzi przez ten plik. Znaczniki SEO nie
 * powstają nigdzie indziej i nie ma powodu, żeby powstawały - dzięki temu
 * nie da się wypuścić podstrony bez `canonical` albo z `og:url` niezgodnym
 * z `canonical`.
 *
 * CO SIĘ STANIE, JEŚLI ZAPOMNISZ O META:
 *   `tytul` i `opis` są wymagane i build PRZERWIE się z nazwą podstrony,
 *   jeśli ich brakuje albo jeśli są puste. Nie ma wartości domyślnej,
 *   bo domyślna oznaczałaby duplikat na dwóch podstronach - a checklista
 *   klasyfikuje duplikat `title`/`description` jako błąd.
 *
 *   `canonical` i `og:url` NIE są parametrem. Liczą się z rzeczywistego
 *   adresu podstrony (`Astro.url.pathname`) i `origin` z konfiguracji,
 *   więc nie da się ich podać błędnie ani zapomnieć.
 */

import { site, adres } from '../config/site'
import { dane } from '../config/dane'
import Naglowek from '../components/layout/Naglowek.astro'
import Stopka from '../components/layout/Stopka.astro'
import Analityka from '../components/layout/Analityka.astro'
import '../styles/global.css'

interface Props {
  /** Unikalny w skali serwisu. Trafia do <title> i og:title. */
  tytul: string
  /** Unikalny w skali serwisu, 120-160 znaków. Trafia do description i og:description. */
  opis: string
  /** Wyłącza indeksowanie tej podstrony. Pamiętaj wtedy o `pozaMapaStrony` w site.ts. */
  noindex?: boolean
  /** Ścieżka do obrazu podglądu linku. Bezwzględna od korzenia, np. `/assets/img/og.jpg`. */
  ogImage?: string
  /** Szerokość i wysokość obrazu podglądu. Serwisy społecznościowe lubią je znać. */
  ogImageRozmiar?: [number, number]
  /**
   * `false` wyłącza `canonical` i `og:url`.
   * Jedyny przypadek, w którym to jest poprawne: dokument serwowany pod
   * adresem innym niż jego ścieżka w buildzie - czyli strona 404. Wskazanie
   * `canonical` na `/404/` deklarowałoby adres, który zwraca błąd.
   */
  kanoniczny?: false
  /**
   * Język TEJ podstrony, jeśli inny niż `site.jezyk`. Idzie do `<html lang>`
   * i `og:locale`. Moduł drugiej wersji językowej - patrz `wersje` niżej.
   */
  jezyk?: string
  /**
   * Wzajemne odwołania między wersjami językowymi, jako `{ 'pl': '/', 'en': '/en/' }`.
   *
   * Komplet MUSI być wzajemny: każda wersja wskazuje wszystkie pozostałe
   * i samą siebie. Niepełne odwołania są w audycie błędem, bo wyszukiwarka
   * traktuje wtedy wersje jako oddzielne, konkurujące ze sobą strony.
   * `canonical` zostaje osobny per wersja - tego nie zmieniamy.
   */
  wersje?: Record<string, string>
}

const {
  tytul,
  opis,
  noindex = false,
  ogImage,
  ogImageRozmiar = [1200, 630],
  kanoniczny: kanonicznyProp,
  jezyk = site.jezyk,
  wersje,
} = Astro.props

const sciezka = Astro.url.pathname
if (!tytul?.trim()) throw new Error(`Podstrona ${sciezka}: brak wymaganego \`tytul\`.`)
if (!opis?.trim()) throw new Error(`Podstrona ${sciezka}: brak wymaganego \`opis\`.`)

const kanoniczny = kanonicznyProp === false ? null : adres(sciezka)
const idStrony = kanoniczny ?? adres(sciezka)
const ogUrl = ogImage ? adres(ogImage) : null

/**
 * Dane strukturalne.
 *
 * Świadomie BEZ `LocalBusiness` w pustej bazie: to deklaracja faktów o firmie
 * (adres, godziny otwarcia, zakres usług), a baza żadnej firmy nie opisuje.
 * Wyszukiwarka dostałaby dane nieistniejącego podmiotu, czyli dokładnie to,
 * co checklista klasyfikuje jako bloker („strona deklaruje coś, co nie jest
 * prawdą"). Blok `LocalBusiness` dla realnego klienta wchodzi w projekcie,
 * po potwierdzeniu danych - wzór jest w README.
 *
 * CSP tego nie blokuje mimo `script-src` bez `unsafe-inline`: `application/ld+json`
 * to dane, nie kod wykonywalny. Nie dodawaj dla niego hasha „na wszelki wypadek".
 */
const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#serwis`,
      url: `${site.origin}/`,
      name: site.nazwa,
      description: site.opis,
      inLanguage: site.jezyk,
    },
    {
      '@type': 'WebPage',
      '@id': `${idStrony}#strona`,
      url: idStrony,
      name: tytul,
      description: opis,
      isPartOf: { '@id': `${site.origin}/#serwis` },
      inLanguage: jezyk,
    },
  ],
}
---

<!doctype html>
<html lang={jezyk}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{tytul}</title>
    <meta name="description" content={opis} />
    {kanoniczny && <link rel="canonical" href={kanoniczny} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nazwa} />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:locale" content={jezyk === site.jezyk ? site.ogLocale : jezyk} />
    {
      wersje &&
        Object.entries(wersje).map(([kod, sciezkaWersji]) => (
          <link rel="alternate" hreflang={kod} href={adres(sciezkaWersji)} />
        ))
    }
    {kanoniczny && <meta property="og:url" content={kanoniczny} />}
    {
      ogUrl && (
        <>
          <meta property="og:image" content={ogUrl} />
          <meta property="og:image:width" content={String(ogImageRozmiar[0])} />
          <meta property="og:image:height" content={String(ogImageRozmiar[1])} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} is:inline />

    <Analityka />

    <slot name="head" />
  </head>

  <body>
    {/*
      Pominięcie nawigacji. Pierwszy element w kolejności Tab, niewidoczny
      do czasu złapania fokusu. Punkt 🧱 checklisty - razem z punktami
      orientacyjnymi niżej (header / nav / main / footer).
    */}
    <a class="pomin-nawigacje" href="#tresc">Przejdź do treści</a>

    <Naglowek />

    <main id="tresc">
      <slot />
    </main>

    <Stopka />

    {/*
      Skrypty wchodzą jako moduł z własnej domeny, nigdy inline.
      `main.ts` uruchamia każdy moduł osobno i łapie jego błędy, więc awaria
      jednego zachowania nie zabija pozostałych (punkt 🧱: „moduły odizolowane
      od siebie"). Bez tego pliku strona nadal się czyta i działa - to jest
      warunek, a nie efekt uboczny.
    */}
    <script>
      import '../scripts/main'
    </script>
  </body>
</html>
