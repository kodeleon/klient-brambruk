---
/**
 * UKŁAD PODSTRONY - jedyne miejsce, w którym powstaje <head>.
 *
 * Stary projekt budował `<head>` w przeglądarce (`react-helmet-async`)
 * i dodatkowo wstrzykiwał go skryptem po buildzie (`scripts/postbuild.mjs`) -
 * dwa źródła prawdy o tych samych znacznikach. Tutaj jest jedno i wykonuje
 * się przy budowaniu.
 *
 * CO SIĘ STANIE, JEŚLI ZAPOMNISZ O META:
 *   `tytul` i `opis` są wymagane i build PRZERWIE się z nazwą podstrony.
 *   Nie ma wartości domyślnej, bo domyślna oznaczałaby duplikat na dwóch
 *   podstronach - a duplikat `title`/`description` jest w audycie błędem.
 *
 *   `canonical` i `og:url` NIE są parametrem. Liczą się z rzeczywistego
 *   adresu podstrony i `origin` z konfiguracji.
 */

import { site, adres } from '../config/site'
import firma from '../content/firma.json'
import { ID_FIRMY, wezelFirmy } from '../lib/daneStrukturalne'
import Naglowek from '../components/layout/Naglowek.astro'
import OgImage from '../components/media/OgImage.astro'
import Stopka from '../components/layout/Stopka.astro'
import Analityka from '../components/layout/Analityka.astro'
import '../styles/global.css'

interface Props {
  /** Unikalny w skali serwisu. Trafia do <title> i og:title. */
  tytul: string
  /** Unikalny w skali serwisu, 120-160 znaków. Trafia do description i og:description. */
  opis: string
  /** Wyłącza indeksowanie tej podstrony. Pamiętaj wtedy o `pozaMapaStrony` w site.ts. */
  noindex?: boolean
  /**
   * Ścieżka do obrazu podglądu linku, bezwzględna od korzenia.
   *
   * Podana - podstrona dostaje własny obraz. Pominięta - wchodzi obraz
   * domyślny z manifestu (`og.domyslny`). Wcześniej podstrona bez tego
   * parametru nie miała `og:image` w ogóle, czyli odnośnik wysłany
   * w wiadomości pokazywał sam tekst.
   */
  ogImage?: string
  ogImageRozmiar?: [number, number]
  /** `false` wyłącza `canonical` i `og:url`. Jedyny poprawny przypadek: strona 404. */
  kanoniczny?: false
  jezyk?: string
}

const {
  tytul,
  opis,
  noindex = false,
  ogImage,
  ogImageRozmiar = [1200, 630],
  kanoniczny: kanonicznyProp,
  jezyk = site.jezyk,
} = Astro.props

const sciezka = Astro.url.pathname
if (!tytul?.trim()) throw new Error(`Podstrona ${sciezka}: brak wymaganego \`tytul\`.`)
if (!opis?.trim()) throw new Error(`Podstrona ${sciezka}: brak wymaganego \`opis\`.`)

const kanoniczny = kanonicznyProp === false ? null : adres(sciezka)
const idStrony = kanoniczny ?? adres(sciezka)
const ogUrl = ogImage ? adres(ogImage) : null

/**
 * Dane strukturalne.
 *
 * `WebSite` + `WebPage` na każdej podstronie, a do tego węzeł firmy
 * (`LocalBusiness`, składany w `src/lib/daneStrukturalne.ts` wyłącznie z
 * `firma.json`). Firma jest prawdziwa, dane potwierdzone przez klienta.
 *
 * Węzeł firmy dostają tylko podstrony indeksowane: `noindex` i 404 nie mają
 * czego deklarować wyszukiwarce. Pełny węzeł na każdej podstronie, a nie
 * tylko na stronie głównej - odwołanie przez `@id` do węzła z innego adresu
 * wyszukiwarka nie rozwiązuje, więc musi być w tym samym dokumencie.
 */
const zFirma = !noindex && kanonicznyProp !== false
const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#serwis`,
      url: `${site.origin}/`,
      name: firma.nazwa,
      description: firma.opisSerwisu,
      inLanguage: site.jezyk,
      ...(zFirma && { publisher: { '@id': ID_FIRMY } }),
    },
    {
      '@type': 'WebPage',
      '@id': `${idStrony}#strona`,
      url: idStrony,
      name: tytul,
      description: opis,
      isPartOf: { '@id': `${site.origin}/#serwis` },
      inLanguage: jezyk,
    },
    ...(zFirma ? [wezelFirmy()] : []),
  ],
}
---

<!doctype html>
<html lang={jezyk}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{tytul}</title>
    <meta name="description" content={opis} />
    {kanoniczny && <link rel="canonical" href={kanoniczny} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon"/>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={firma.nazwa} />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:locale" content={jezyk === site.jezyk ? site.ogLocale : jezyk} />
    {kanoniczny && <meta property="og:url" content={kanoniczny} />}
    {
      ogUrl ? (
        <>
          <meta property="og:image" content={ogUrl} />
          <meta property="og:image:width" content={String(ogImageRozmiar[0])} />
          <meta property="og:image:height" content={String(ogImageRozmiar[1])} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : (
        <OgImage use="og.domyslny" />
      )
    }

    <script type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} is:inline />

    <Analityka />

    <slot name="head" />
  </head>

  <body>
    {/*
      Pominięcie nawigacji. Pierwszy element w kolejności Tab, niewidoczny
      do czasu złapania fokusu. Stary projekt tego nie miał.
    */}
    <a class="pomin-nawigacje" href="#tresc">Przejdź do treści</a>

    {/* Ten `div` odpowiada korzeniowi aplikacji ze starego `App.jsx` -
        stąd te same klasy tła, kroju i koloru tekstu. */}
    <div class="min-h-screen bg-brand-bg font-body text-brand-text">
      <Naglowek />

      {/* `overflow-x-clip`: treść nie może poszerzać strony. Elementy
          odsłaniane z boku (`Odslon wariant="left"/"right"`) czekają
          przesunięte o 2rem poza krawędź ekranu, a strona szersza niż ekran
          każe mobilnemu Chrome'owi poszerzyć obszar układu - przyklejony
          nagłówek trzymał się wtedy jego krawędzi, nie ekranu, i chował się
          o ~26 px pod górną krawędź, dopóki wszystko się nie odsłoniło.
          `clip`, nie `hidden`: `hidden` robi z `<main>` kontener przewijania
          i psuje każdy `position: sticky` w środku.
          Na `<html>` to nie działa - sprawdzone, Chrome i tak poszerza układ. */}
      <main id="tresc" class="overflow-x-clip">
        <slot />
      </main>

      <Stopka />
    </div>

    <script>
      import '../scripts/main'
    </script>
  </body>
</html>
