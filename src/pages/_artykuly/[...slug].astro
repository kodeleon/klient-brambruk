---
/**
 * POJEDYNCZY ARTYKUŁ - moduł opcjonalny (pakiet Premium).
 *
 * Każdy artykuł to osobny plik HTML z własnym `title`, `description`
 * i `canonical` - tak samo jak każda inna podstrona. Trafia do mapy strony
 * i do audytu automatycznie.
 */
import { getCollection, render } from 'astro:content'
import Podstrona from '../../layouts/Podstrona.astro'

export async function getStaticPaths() {
  const artykuly = await getCollection('artykuly', ({ data }) => !data.szkic)
  return artykuly.map((artykul) => ({ params: { slug: artykul.id }, props: { artykul } }))
}

const { artykul } = Astro.props
const { Content } = await render(artykul)

const dataPl = artykul.data.data.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<Podstrona tytul={artykul.data.tytul} opis={artykul.data.opis}>
  <article class="sekcja">
    <div class="wrap">
      <div class="naglowek-sekcji">
        <h1 class="tytul-glowny">{artykul.data.tytul}</h1>
        <p class="lead">{artykul.data.opis}</p>
        <p>
          <time datetime={artykul.data.data.toISOString().slice(0, 10)}>{dataPl}</time>
          {artykul.data.autor && <> · {artykul.data.autor}</>}
        </p>
      </div>

      <div class="proza">
        <Content />
      </div>
    </div>
  </article>
</Podstrona>
