---
/**
 * LISTA ARTYKUŁÓW - moduł opcjonalny (pakiet Premium).
 *
 * Katalog zaczyna się od podkreślenia, więc Astro pomija go w routingu.
 * Włączenie modułu: zmień nazwę katalogu na `artykuly` - instrukcja
 * w `src/content.config.ts`.
 */
import { getCollection } from 'astro:content'
import Podstrona from '../../layouts/Podstrona.astro'

const artykuly = (await getCollection('artykuly', ({ data }) => !data.szkic)).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf()
)

const dataPl = (d: Date) =>
  d.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })
---

<Podstrona
  tytul="Artykuły"
  opis="Poradniki i wskazówki od naszego zespołu. Praktyczna wiedza, bez lania wody."
>
  <section class="sekcja">
    <div class="wrap">
      <div class="naglowek-sekcji" data-odslon>
        <span class="nadtytul">Baza wiedzy</span>
        <h1 class="tytul-glowny">Artykuły</h1>
      </div>

      {
        artykuly.length === 0 ? (
          <p class="lead">Pierwsze artykuły pojawią się wkrótce.</p>
        ) : (
          <ul class="siatka-kart">
            {artykuly.map((a, i) => (
              <li class="karta" data-odslon={i * 100}>
                <h2 class="karta__tytul">
                  <a class="link" href={`/artykuly/${a.id}/`}>{a.data.tytul}</a>
                </h2>
                <p>
                  <time datetime={a.data.data.toISOString().slice(0, 10)}>{dataPl(a.data.data)}</time>
                </p>
                <p>{a.data.opis}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Podstrona>
