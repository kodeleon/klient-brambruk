---
/**
 * / - strona główna.
 *
 * Następczyni `code/src/pages/Home.jsx`. Po przejściu po wyglądzie
 * (18.09.2026) zmieniło się pięć rzeczy - każda ma uzasadnienie przy sekcji,
 * której dotyczy. Wspólny mianownik: sekcje miały tę samą wagę wizualną,
 * więc żadna nie prowadziła dalej.
 */
import Podstrona from "../layouts/Podstrona.astro";
import { dane, opinie, fixly, statystyki } from "../config/dane";
import EtykietaSekcji from "../components/ui/EtykietaSekcji.astro";
import Przycisk from "../components/ui/Przycisk.astro";
import LinkSekcji from "../components/ui/LinkSekcji.astro";
import Odslon from "../components/ui/Odslon.astro";
import KartaUslugi from "../components/ui/KartaUslugi.astro";
import KartaOpinii from "../components/ui/KartaOpinii.astro";
import PasekStatystyk from "../components/ui/PasekStatystyk.astro";
import SekcjaFaq from "../components/ui/SekcjaFaq.astro";
import PrzyciskiWyceny from "../components/ui/PrzyciskiWyceny.astro";
import Przenoszony from "../components/ui/Przenoszony.astro";
import GaleriaSiatka from "../components/ui/GaleriaSiatka.astro";
import GaleriaKaruzela from "../components/ui/GaleriaKaruzela.astro";
import BanerCta from "../components/ui/BanerCta.astro";
import SekcjaHero from "../components/ui/SekcjaHero.astro";
import PrzyciskFixly from "../components/ui/PrzyciskFixly.astro";
import Ikona from "../components/icons/Ikona.astro";
import Foto from "../components/media/Foto.astro";
import Logo from "../components/media/Logo.astro";

/**
 * Karty typów usług. `tagi` wypisują rodzaje z danego zakresu - odwiedzający
 * ma zobaczyć „bramy przesuwne", zanim kliknie, a nie dopiero na hubie.
 * Cztery pozycje to sufit: piąta nie mieści się w jednym wierszu na telefonie.
 */
const uslugi = [
  {
    tytul: "Ogrodzenia i bramy",
    opis: "Montaż ogrodzeń panelowych, murowanych i z siatki. Bramy przesuwne, dwuskrzydłowe, furtki. Automatyka i sterowanie.",
    foto: "karta.glowna-ogrodzenia",
    href: "/ogrodzenia/",
  },
  {
    tytul: "Brukarstwo",
    opis: "Układanie kostki brukowej na podjazdy, chodniki, alejki ogrodowe i tarasy. Pełna realizacja z podbudową.",
    foto: "karta.glowna-brukarstwo",
    href: "/brukarstwo/",
  },
  {
    tytul: "Budownictwo",
    opis: "Altany ogrodowe, garaże blaszane i drewniane, domki narzędziowe, wiaty. Solidna konstrukcja, terminowy montaż.",
    foto: "karta.glowna-budownictwo",
    href: "/budownictwo/",
  },
];

/* Podpisy są dociągnięte do tego, co faktycznie jest na zdjęciu - klucz
   `realizacja.NN` znaczy jedno zdjęcie i jeden temat na całej witrynie. */
const galeria = [
  {
    foto: "realizacja.01",
    tytul: "Ogrodzenie panelowe + brama",
    lokalizacja: "Biała Podlaska",
  },
  {
    foto: "realizacja.02",
    tytul: "Podjazd z kostki",
    lokalizacja: "Międzyrzec Podlaski",
  },
  {
    foto: "realizacja.08",
    tytul: "Brama przesuwna",
    lokalizacja: "Janów Podlaski",
  },
  { foto: "realizacja.04", tytul: "Altana ogrodowa", lokalizacja: "Terespol" },
  {
    foto: "realizacja.07",
    tytul: "Furtka i przęsła",
    lokalizacja: "Radzyń Podlaski",
  },
  {
    foto: "realizacja.09",
    tytul: "Chodniki i obrzeża",
    lokalizacja: "Sławacinek Stary",
  },
];

/** Liczby w sekcji głównej. Wartości z `dane.ts`, nie wpisane tutaj. */
const kluczoweLiczby = [
  { wartosc: fixly.ocena, etykieta: "ocena na Fixly" },
  { wartosc: statystyki.realizacje, etykieta: "realizacji" },
  { wartosc: `${statystyki.lata} lat`, etykieta: "w regionie" },
];

const faq = [
  {
    pytanie: "Czy wycena jest bezpłatna?",
    odpowiedz:
      "Tak, wycena jest całkowicie bezpłatna i niezobowiązująca. Wystarczy opisać projekt przez formularz lub zadzwonić - odpowiemy w ciągu 24 godzin.",
  },
  {
    pytanie: "Jak długo trwa realizacja ogrodzenia?",
    odpowiedz:
      "Standardowe ogrodzenie panelowe (50–100 mb) montujemy w 2–5 dni roboczych. Bardziej złożone projekty z podmurówką i bramami mogą zająć 1–2 tygodnie.",
  },
  {
    pytanie: "Jaki jest obszar działania firmy?",
    odpowiedz:
      "Pracujemy w promieniu około 100 km od Białej Podlaskiej, czyli w województwie lubelskim, podlaskim i mazowieckim. Najczęściej jeździmy do Międzyrzeca Podlaskiego, Radzynia Podlaskiego, Łukowa, Siedlec, Łosic, Terespola, Janowa Podlaskiego i Parczewa. Mieszkasz dalej - zadzwoń, sprawdzimy, czy damy radę dojechać.",
  },
  {
    pytanie: "Co wpływa na cenę ogrodzenia?",
    odpowiedz:
      "Na cenę wpływa typ ogrodzenia, długość, wysokość, rodzaj podmurówki, kolor RAL, typ gruntu i nachylenie terenu. Dokładną wycenę przygotujemy po poznaniu szczegółów.",
  },
  {
    pytanie: "Czy potrzebuję pozwolenia na budowę ogrodzenia?",
    odpowiedz:
      "Ogrodzenie do 2,2 m wysokości co do zasady nie wymaga pozwolenia, ale budowę należy zgłosić do starostwa. Pomożemy ustalić formalności dla Twojego projektu.",
  },
];

const kroki = [
  {
    numer: "01",
    tytul: "Kontakt i opis projektu",
    opis: "Wypełnij formularz wyceny - opisz co chcesz zrealizować, podaj orientacyjne wymiary i lokalizację. Możesz też zadzwonić lub napisać e-mail.",
  },
  {
    numer: "02",
    tytul: "Bezpłatna wycena w 24h",
    opis: "Na podstawie Twojego opisu przygotujemy orientacyjną wycenę i odeślemy ją w ciągu jednego dnia roboczego. W razie potrzeby umówimy wizję lokalną.",
  },
  {
    numer: "03",
    tytul: "Realizacja i odbiór",
    opis: "Ekipa przyjeżdża w ustalonym terminie. Pracujemy sprawnie i zostawiamy posesję w porządku. Po zakończeniu odbierasz gotową realizację z gwarancją.",
  },
];
---

<Podstrona
  tytul="Ogrodzenia, bramy i brukarstwo - BramBruk | Biała Podlaska i okolice"
  opis="Ogrodzenia panelowe, bramy, furtki i kostka brukowa w Białej Podlaskiej i okolicach. 50+ realizacji, 6 lat doświadczenia. Bezpłatna wycena w 24h."
>
  {
    /* ═══ SEKCJA GŁÓWNA ═══════════════════════════════════
      Układ, tło i odstępy: `SekcjaHero.astro` - ten sam wzór na każdej
      podstronie. Tutaj zostaje wyłącznie treść i to, co na stronie
      głównej jest wyjątkowe: kolaż trzech zdjęć zamiast jednego.
  */
  }
  <SekcjaHero
    etykieta={["Ogrodzenia", "Brukarstwo", "Budownictwo"]}
    tytul={"Ogrodzenia, bramy\ni brukarstwo"}
    podtytul="Lubelskie, podlaskie i mazowieckie"
    opis={`Montaż ogrodzeń panelowych, bram wjazdowych i furtek. Układanie kostki brukowej na podjazdy, chodniki i tarasy. Pracujemy w promieniu ${statystyki.zasieg} od Białej Podlaskiej.`}
    foto="hero.glowna"
    duzyTytul
  >
    <Fragment slot="akcje">
      <Przycisk href="/wycena/" rozmiar="lg" ikona="receipt-text"
        >Bezpłatna wycena</Przycisk
      >
      <Przycisk
        href={`tel:${dane.telefonHref}`}
        wariant="secondary"
        rozmiar="lg"
        ikona="phone">Zadzwoń</Przycisk
      >
    </Fragment>

    {
      /* Liczby były wcześniej jednym wierszem drobnego tekstu w kolorze
        o kontraście 3,52:1 - czyli dowód na wiarygodność firmy wyglądał
        jak stopka. Teraz: wartość w kolorze akcentu, etykieta pod nią. */
    }
    <dl slot="dodatek" class="mt-10 flex flex-nowrap gap-x-8 gap-y-4">
      {
        kluczoweLiczby.map((pozycja) => (
          <div class="text-center">
            <dd class="font-display text-2xl lg:text-3xl font-bold text-brand-olive leading-none">
              {pozycja.wartosc}
            </dd>
            <dt class="mt-1.5 text-[11px] font-semibold uppercase tracking-[2px] text-neutral-400">
              {pozycja.etykieta}
            </dt>
          </div>
        ))
      }
    </dl>

    {
      /* Trzy prostokąty NACHODZĄ na siebie. Największy leży NA SPODZIE
        i jest częściowo przykryty przez dwa mniejsze - odwrotna kolejność
        czytała się jak trzy osobne zdjęcia poukładane przypadkiem.
        Warstwy rozdziela cień, nie obwódka: obwódka w kolorze tła rysowała
        wokół każdego zdjęcia ramkę, której nikt nie zamawiał. */
    }
    <div slot="obok" class="relative h-[520px]">
      <div
        class="absolute left-0 top-8 z-0 w-[320px] overflow-hidden rounded-2xl shadow-2xl shadow-black/70"
      >
        <Foto klucz="hero.glowna-kolaz-1" class="w-full object-cover" />
      </div>
      <div
        class="absolute right-0 top-0 z-10 w-[240px] overflow-hidden rounded-2xl shadow-2xl shadow-black/70"
      >
        <Foto klucz="hero.glowna-kolaz-2" class="w-full object-cover" />
      </div>
      <div
        class="absolute left-[180px] bottom-0 z-20 w-[260px] overflow-hidden rounded-2xl shadow-2xl shadow-black/70"
      >
        <Foto klucz="hero.glowna-kolaz-3" class="w-full object-cover" />
      </div>
    </div>

    <div
      slot="stopka"
      class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-neutral-400 animate-bounce lg:block"
      aria-hidden="true"
    >
      <Ikona nazwa="chevron-down" rozmiar={20} />
    </div>
  </SekcjaHero>

  {/* ═══ USŁUGI ══════════════════════════════════════════ */}
  <section class="tlo-siatka bg-brand-section py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <div
          class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-6"
        >
          <div>
            <EtykietaSekcji>Nasze usługi</EtykietaSekcji>
            <h2
              class="font-display text-2xl lg:text-4xl font-bold text-brand-text mt-2"
            >
              Kompleksowa obsługa Twojej posesji
            </h2>
          </div>
          <LinkSekcji href="/uslugi/" ikona="banknote" miejsce="naglowek"
            >Wszystkie usługi i cennik</LinkSekcji
          >
        </div>
      </Odslon>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          uslugi.map((usluga, i) => (
            <Odslon wariant="up" zwloka={i * 80}>
              <KartaUslugi
                tytul={usluga.tytul}
                opis={usluga.opis}
                foto={usluga.foto}
                href={usluga.href}
              />
            </Odslon>
          ))
        }
      </div>

      <LinkSekcji href="/uslugi/" ikona="banknote"
        >Wszystkie usługi i cennik</LinkSekcji
      >
    </div>
  </section>

  {/* ═══ REALIZACJE ══════════════════════════════════════ */}
  <section class="bg-brand-bg py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <div
          class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-6"
        >
          <div>
            <EtykietaSekcji>Realizacje</EtykietaSekcji>
            <h2
              class="font-display text-2xl lg:text-4xl font-bold text-brand-text mt-2"
            >
              Nasze ostatnie projekty
            </h2>
          </div>
          <LinkSekcji href="/realizacje/" ikona="images" miejsce="naglowek"
            >Zobacz wszystkie realizacje</LinkSekcji
          >
        </div>
      </Odslon>

      <GaleriaSiatka pozycje={galeria} class="hidden md:grid" />
      <GaleriaKaruzela pozycje={galeria} class="md:hidden" />

      <LinkSekcji href="/realizacje/" ikona="images"
        >Zobacz wszystkie realizacje</LinkSekcji
      >
    </div>
  </section>

  {
    /* ═══ O FIRMIE ════════════════════════════════════════
      Lewa kolumna mówi, prawa pokazuje: znak firmowy, cztery liczby
      i wyjście na /o-nas/. Wcześniej liczby stały pod tekstem po lewej,
      a prawa kolumna kończyła się na logo i pustce pod nim.

      Etykieta stoi NAD kolumnami i zajmuje pełną szerokość - inaczej
      prawa kolumna zaczyna się wizualnie wyżej niż lewa i to ona łapie
      wzrok jako pierwsza, jeszcze przed nagłówkiem sekcji.
  */
  }
  <section class="tlo-siatka bg-brand-section py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <EtykietaSekcji>O firmie</EtykietaSekcji>
      </Odslon>

      <div
        class="mt-2 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start"
      >
        <Odslon wariant="left">
          <div>
            <h2
              class="font-display text-2xl lg:text-4xl font-bold text-brand-text mb-6"
            >
              BramBruk - od {statystyki.lata} lat w regionie
            </h2>
            <p class="text-brand-text-light leading-relaxed mb-4">
              Jesteśmy lokalną firmą z Białej Podlaskiej specjalizującą się w
              ogrodzeniach, brukarstwie i budownictwie lekkim. Każdego roku
              realizujemy dziesiątki projektów dla klientów indywidualnych i
              przedsiębiorstw w województwie lubelskim, podlaskim i mazowieckim.
            </p>
            <p class="text-brand-text-light leading-relaxed mb-4">
              Stawiamy na jakość materiałów, terminowość i transparentną wycenę.
              Każdy projekt poprzedzamy bezpłatną wizją lokalną - tak żebyście
              Państwo dokładnie wiedzieli, co i za ile zostanie wykonane.
            </p>
            <PasekStatystyk class="w-full text-center" />
          </div>
        </Odslon>

        <Odslon wariant="right" class="h-full">
          <div class="flex flex-col items-center gap-7 h-full justify-between">
            <Logo
              nazwa="pelne"
              alt=""
              sizes="(max-width:1024px) 80vw, 520px"
              class="w-full max-w-[520px] h-auto"
            />
            <Przycisk
              href="/o-nas/"
              wariant="outline"
              rozmiar="md"
              ikona="building-2">Więcej o firmie</Przycisk
            >
          </div>
        </Odslon>
      </div>
    </div>
  </section>

  {/* ═══ OPINIE ══════════════════════════════════════════ */}
  <section class="tlo-siatka tlo-siatka--lewo bg-brand-bg py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <div class="mb-6">
          <EtykietaSekcji wariant="fixly">Opinie klientów</EtykietaSekcji>
          <h2
            class="font-display text-2xl lg:text-4xl font-bold text-brand-text mt-2 mb-2"
          >
            Co mówią nasi klienci
          </h2>
          <p
            class="text-brand-text-light text-sm flex flex-wrap items-center gap-2"
          >
            <span
              class="flex text-fixly-main"
              role="img"
              aria-label={`Ocena ${fixly.ocena}`}
            >
              {
                Array.from({ length: 5 }).map(() => (
                  <Ikona nazwa="star" rozmiar={14} wypelnienie="currentColor" />
                ))
              }
            </span>
            <span>{fixly.ocena} średnia ocen na</span>
            <PrzyciskFixly />
            <span>· {fixly.opinie} opinii</span>
          </p>
        </div>
      </Odslon>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          opinie.map((opinia, i) => (
            <Odslon wariant="up" zwloka={i * 80}>
              <KartaOpinii
                imie={opinia.imie}
                lokalizacja={opinia.lokalizacja}
                data={opinia.data}
                tresc={opinia.tresc}
                ocena={opinia.ocena}
              />
            </Odslon>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ═══ JAK DZIAŁAMY ════════════════════════════════════
      Lewa kolumna trzyma wszystko, co mówi (nagłówek, opis, przyciski),
      prawa wyłącznie trzy kroki - jedna kolumna, jedna rola. Etykieta
      nad kolumnami, tak jak w każdej innej sekcji dwukolumnowej.

      Przyciski (`PrzyciskiWyceny`) stoją w dwóch miejscach siatki, ale
      renderuje się zawsze jedna para: przy dwóch kolumnach pod tekstem
      po lewej, przy jednej - pod krokami, na końcu sekcji. Decyzja zapada
      po przeczytaniu kroków, więc przycisk ma stać tam, gdzie kończy się
      czytanie, a nie w środku sekcji. Przełączaniem steruje `Przenoszony`.
  */
  }
  <section class="tlo-siatka bg-brand-section py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <Odslon>
        <EtykietaSekcji>Jak działamy</EtykietaSekcji>
      </Odslon>

      <div
        class="mt-2 grid grid-cols-1 lg:grid-cols-2 gap-5 lg:gap-16 items-start"
      >
        <Odslon wariant="left">
          <div class="lg:sticky lg:top-[calc(var(--naglowek-wysokosc)+2rem)]">
            <h2
              class="font-display text-2xl lg:text-4xl font-bold text-brand-text mb-5"
            >
              Od zapytania do gotowej realizacji
            </h2>
            <p class="text-brand-text-light leading-relaxed mb-4">
              Zrealizujemy ogrodzenie, podjazd z kostki lub altanę - niezależnie
              od wielkości projektu. Wystarczy, że opiszesz swoje potrzeby.
            </p>
            <p class="text-brand-text-light leading-relaxed mb-4">
              Wypełnij formularz online lub zadzwoń - zadamy kilka pytań, żeby
              przygotować wycenę dokładnie dopasowaną do Twojej posesji i
              budżetu.
            </p>
            <p class="text-brand-text-light leading-relaxed mb-0 lg:mb-10">
              W ciągu 24 godzin od wysłania zgłoszenia otrzymasz orientacyjną
              wycenę. Następnie ustalamy termin, przyjeżdżamy i realizujemy -
              bez ukrytych kosztów.
            </p>

            <Przenoszony miejsce="kolumna">
              <PrzyciskiWyceny />
            </Przenoszony>
          </div>
        </Odslon>

        <div class="space-y-4">
          {
            kroki.map((krok, i) => (
              <Odslon wariant="right" zwloka={i * 100}>
                <div class="flex gap-4 bg-brand-card border border-brand-border/60 rounded-2xl px-3 py-4 shadow-sm shadow-black/[0.04] hover:shadow-md hover:shadow-black/[0.06] transition-shadow duration-300">
                  <div class="shrink-0 w-11 h-11 rounded-xl bg-brand-olive/15 flex items-center justify-center">
                    <span class="font-display text-base font-bold text-brand-olive-text">
                      {krok.numer}
                    </span>
                  </div>
                  <div>
                    <h3 class="font-display text-base font-bold text-brand-text mb-1">
                      {krok.tytul}
                    </h3>
                    <p class="text-sm text-brand-text-light leading-relaxed">
                      {krok.opis}
                    </p>
                  </div>
                </div>
              </Odslon>
            ))
          }
        </div>

        <Przenoszony miejsce="pod">
          <PrzyciskiWyceny />
        </Przenoszony>
      </div>
    </div>
  </section>

  <SekcjaFaq pytania={faq} />

  <BanerCta tytul="Chcesz poznać dokładną cenę?" />
</Podstrona>
