---
/**
 * /wycena/ - kreator wyceny w pięciu krokach.
 *
 * Odpowiednik `code/src/pages/Wycena.jsx` (36 kB Reacta). Tutaj cały
 * formularz jest w HTML, a `src/scripts/wycena.ts` chowa kroki, waliduje,
 * zapisuje postęp w `localStorage` i składa podsumowanie.
 *
 * ┌── DLACZEGO MODUŁ, A NIE WYSPA REACT ────────────────────────────────┐
 * │ Formalnie kreator przechodzi próg wyspy z README bazy (pięć kroków,  │
 * │ walidacja krzyżowa, zapis postępu, upload). Kosztowałoby to ~69 kB   │
 * │ gzip na tej podstronie i powrót Reacta do zależności projektu.       │
 * │ Stan kreatora jest jednak płaski: jeden obiekt pól, jedna zależność  │
 * │ (typ usługi → lista podtypów) i pięć widoków. Ręczne pilnowanie tego │
 * │ broni się bez frameworka, a formularz bez JavaScriptu zostaje jedną  │
 * │ długą, czytelną formą zamiast pustej strony.                         │
 * └──────────────────────────────────────────────────────────────────────┘
 *
 * WYSYŁKA: do Workera z `forms-worker/` (`src/scripts/formularz.ts`),
 * zdjęcia kompresowane w przeglądarce (`src/scripts/zdjecia.ts`). Nazwy pól,
 * klucze opcji i limity to kontrakt z Workerem - `src/config/formularze.ts`.
 */
import Podstrona from '../layouts/Podstrona.astro'
import wycena from '../content/wycena.json'
import { wpis } from '../lib/tresc'
import Okruszki from '../components/ui/Okruszki.astro'
import EtykietaSekcji from '../components/ui/EtykietaSekcji.astro'
import Przycisk from '../components/ui/Przycisk.astro'
import OsCzasuProcesu from '../components/ui/OsCzasuProcesu.astro'
import Ikona from '../components/icons/Ikona.astro'
import Foto from '../components/media/Foto.astro'
import { adresFormularza } from '../config/site'
import { LIMITY, POLE_PULAPKA, ZDJECIA } from '../config/formularze'

const { typy: typyUslug, podtypy, teren: opcjeTerenu, termin: opcjeTerminu, budzet: opcjeBudzetu } = wycena

const strona = await wpis('strony', 'wycena')
const { hero, etapy, sukces, zdjecia, podsumowanie, rodo, przyciski, licznikKrokow } = strona
const kroki = strona.kroki ?? []

const klasaPola =
  'w-full px-4 py-3 rounded-lg border bg-white text-brand-text text-sm focus:outline-none focus:border-brand-olive focus:ring-2 focus:ring-brand-olive/10 transition-all border-brand-border'
const klasaChipa =
  'chip inline-flex px-5 py-2.5 rounded-full border text-sm font-medium transition-all duration-200 border-brand-border bg-brand-card text-brand-text-light hover:border-brand-olive/40 hover:text-brand-text'

const wierszePodsumowania = podsumowanie.wiersze
const limity = LIMITY.quote
---

<Podstrona
  tytul={strona.meta.tytul}
  opis={strona.meta.opis}
>
  <Okruszki pozycje={[{ etykieta: 'Strona główna', sciezka: '/' }, { etykieta: 'Wycena' }]} />

  {/* ═══ PODZIĘKOWANIE - odsłania je skrypt po udanej wysyłce ═══ */}
  <div data-wycena-sukces tabindex="-1" class="focus:outline-none" hidden>
    <section class="bg-brand-section py-4 lg:py-10">
      <div class="max-w-2xl mx-auto px-5 lg:px-10">
        <div class="bg-brand-card border border-brand-border rounded-2xl px-3 py-5 lg:px-4 lg:py-6 text-center">
          <div
            class="w-10 h-10 rounded-xl bg-brand-olive/10 flex items-center justify-center text-brand-olive-text mx-auto mb-3"
          >
            <Ikona nazwa="check-circle-2" rozmiar={20} />
          </div>
          <h2 class="font-display text-xl lg:text-2xl font-bold text-brand-text">{sukces.tytul}</h2>
          <p class="mt-2 text-sm text-brand-text-light">
            {sukces.opisPrzed}
            <strong class="text-brand-text font-semibold">{sukces.opisMocny}</strong>.
          </p>
          <OsCzasuProcesu aktywny="2" etykieta={sukces.etykietaOsi} kompakt />
          <div class="flex flex-wrap justify-center gap-3">
            <Przycisk href="/" wariant="outline" ikona="home">{sukces.przycisk}</Przycisk>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div data-wycena>
    {/* Sekcja główna kreatora jest wyśrodkowana - to jedyna taka na
        serwisie i tak ma zostać, bo kreator nie ma drugiej kolumny.
        Tło jest jednak liczone tak samo jak wszędzie: na szerokim ekranie
        czysta płaszczyzna z siatką techniczną, na wąskim zdjęcie pod
        gradientem. Mechanizm: `styles/components/hero.css`. */}
    <section class="relative bg-brand-dark overflow-hidden">
      <div class="absolute inset-0 lg:hidden" aria-hidden="true">
        <Foto klucz="hero.ogrodzenia" alt="" class="absolute inset-0 h-full w-full object-cover" />
        <div class="sekcja-hero__maska absolute inset-0"></div>
      </div>
      <div class="sekcja-hero__siatka absolute inset-0 hidden lg:block" aria-hidden="true"></div>
      <div class="sekcja-hero__swiatlo absolute inset-0 hidden lg:block" aria-hidden="true"></div>
      <div class="relative max-w-7xl mx-auto px-5 lg:px-10 py-10 lg:py-14 text-center">
        <EtykietaSekcji wariant="ciemne" class="mb-3">{hero.etykieta}</EtykietaSekcji>
        <h1 class="font-display text-3xl lg:text-[42px] font-bold text-white leading-tight mb-3">
          {hero.tytul}
        </h1>
        <p class="text-neutral-400 max-w-lg mx-auto">{hero.opis}</p>

        {/* Wskaźnik kroków - stany aktualizuje skrypt. */}
        <div class="mt-8 max-w-2xl mx-auto">
          <div class="flex items-start justify-between gap-1" data-wskaznik>
            {
              kroki.map((krok, i) => (
                <div class="flex items-start flex-1 last:flex-initial">
                  <button
                    type="button"
                    class="flex flex-col items-center group"
                    data-wskaznik-krok={i}
                    disabled={i > 0}
                  >
                    <span
                      class="wskaznik-kolko w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold border-2 transition-all duration-250"
                    >
                      <span data-wskaznik-numer>{i + 1}</span>
                      <Ikona nazwa="check" rozmiar={16} class="wskaznik-ptaszek" />
                    </span>
                    <span class="wskaznik-etykieta mt-1.5 text-[10px] font-semibold tracking-wide hidden sm:block leading-tight text-center max-w-[64px]">
                      {krok.etykieta}
                    </span>
                    <span class="wskaznik-opis mt-0.5 text-[9px] hidden lg:block text-center max-w-[80px] leading-tight">
                      {krok.opis}
                    </span>
                  </button>
                  {i < kroki.length - 1 && (
                    <div class="flex-1 mx-2 mt-[calc((2.25rem-0.125rem)/2)]">
                      <div class="wskaznik-kreska h-0.5 rounded-full transition-colors duration-300"></div>
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="bg-brand-bg py-10 lg:py-14 scroll-mt-[72px]" data-wycena-formularz>
      <div class="max-w-4xl mx-auto px-5 lg:px-10">
        <form
          class="bg-brand-card rounded-2xl border border-brand-border/60 shadow-sm shadow-black/[0.04] px-3 py-5 lg:px-4 lg:py-6"
          novalidate
          data-formularz="wycena"
          data-adres={adresFormularza('quote')}
        >
          <p class="text-xs text-brand-text-light mb-1">
            {licznikKrokow.przed} <span data-wycena-numer>1</span> {licznikKrokow.miedzy} {kroki.length}
          </p>
          <p class="text-xs font-semibold text-brand-sage mb-6" data-wycena-etykieta>{kroki[0].etykieta}</p>

          {/* ═══ KROK 1 - typ usługi ═══════════════════════ */}
          <div data-krok="0">
            <h2 class="font-display text-2xl lg:text-3xl font-bold text-brand-text">{etapy[0].tytul}</h2>
            <p class="mt-2 text-sm text-brand-text-light" data-krok0-opis>{etapy[0].opis}</p>
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
              {
                typyUslug.map((typ) => (
                  <div>
                    <input
                      type="radio"
                      name="serviceType"
                      id={`typ-${typ.klucz}`}
                      value={typ.klucz}
                      class="poza-ekranem karta-pole"
                      data-pole="serviceType"
                    />
                    <label
                      for={`typ-${typ.klucz}`}
                      class="karta-wyboru flex flex-col text-left rounded-2xl border-2 overflow-hidden transition-all duration-300 justify-start border-brand-border/60 hover:border-brand-olive/40"
                    >
                      <span class="relative block aspect-[16/8] overflow-hidden">
                        <Foto klucz={typ.foto} alt={typ.etykieta} class="w-full h-full object-cover" />
                        <span class="karta-przeslona absolute inset-0 bg-brand-olive/15"></span>
                        <span
                          class="karta-ikona absolute top-3 right-3 w-9 h-9 rounded-xl flex items-center justify-center transition-colors bg-white/90 text-brand-olive-text"
                        >
                          <Ikona nazwa={typ.ikona as 'shield'} rozmiar={18} />
                        </span>
                      </span>
                      <span class="block p-4 bg-brand-card">
                        <span class="block text-sm font-bold text-brand-text">{typ.etykieta}</span>
                        <span class="block mt-1 text-xs text-brand-text-light leading-relaxed">{typ.opis}</span>
                      </span>
                    </label>
                  </div>
                ))
              }
            </div>
            <p class="mt-3 text-xs text-red-500" data-blad="serviceType" hidden></p>
          </div>

          {/* ═══ KROK 2 - szczegóły ════════════════════════ */}
          <div data-krok="1" class="space-y-8">
            <div>
              <h2 class="font-display text-2xl lg:text-3xl font-bold text-brand-text">{etapy[1].tytul}</h2>
              <p class="mt-2 text-sm text-brand-text-light">{etapy[1].opis}</p>
              <div class="mt-6">
                <span class="block text-xs font-semibold text-brand-text mb-3">Rodzaj</span>
                {
                  Object.entries(podtypy).map(([typ, lista]) => (
                    <div class="flex flex-wrap gap-2" data-podtypy={typ} hidden>
                      {lista.map((podtyp) => (
                        <span>
                          <input
                            type="radio"
                            name="subtype"
                            id={`podtyp-${podtyp.klucz}`}
                            value={podtyp.klucz}
                            class="poza-ekranem chip-pole"
                            data-pole="subtype"
                          />
                          <label for={`podtyp-${podtyp.klucz}`} class={klasaChipa}>{podtyp.etykieta}</label>
                        </span>
                      ))}
                    </div>
                  ))
                }
                <p class="mt-2 text-xs text-red-500" data-blad="subtype" data-zalezne hidden></p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-brand-text mb-2" for="pole-wymiary">
                  Orientacyjne wymiary
                </label>
                <div class="flex">
                  <input
                    id="pole-wymiary"
                    name="amount"
                    inputmode="decimal"
                    data-pole="amount"
                    data-limit={limity.amount}
                    aria-describedby="blad-amount"
                    placeholder="np. 40"
                    class={`${klasaPola} flex-1 rounded-r-none`}
                  />
                  <span
                    class="px-4 py-3 rounded-r-lg bg-brand-section border border-l-0 border-brand-border text-sm text-brand-text-light font-medium"
                    data-jednostka>mb</span>
                </div>
                <p class="mt-1 text-xs text-red-500" id="blad-amount" data-blad="amount" hidden></p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-brand-text mb-2" for="pole-lokalizacja">
                  Miejscowość
                </label>
                <input
                  id="pole-lokalizacja"
                  name="location"
                  data-pole="location"
                  data-limit={limity.location}
                  aria-describedby="blad-location"
                  placeholder="np. Biała Podlaska"
                  class={klasaPola}
                />
                <p class="mt-1 text-xs text-red-500" id="blad-location" data-blad="location" hidden></p>
              </div>
            </div>
          </div>

          {/* ═══ KROK 3 - dodatkowe ════════════════════════ */}
          <div data-krok="2" class="space-y-8">
            <div>
              <h2 class="font-display text-2xl lg:text-3xl font-bold text-brand-text">{etapy[2].tytul}</h2>
              <p class="mt-2 text-sm text-brand-text-light">{etapy[2].opis}</p>
            </div>
            <div>
              <span class="block text-xs font-semibold text-brand-text mb-3">Utrudnienia terenu</span>
              <div class="flex flex-wrap gap-2">
                {
                  opcjeTerenu.map((opcja) => (
                    <span>
                      <input
                        type="checkbox"
                        name="terrain"
                        id={`teren-${opcja.klucz}`}
                        value={opcja.klucz}
                        class="poza-ekranem chip-pole"
                        data-pole="terrain"
                      />
                      <label for={`teren-${opcja.klucz}`} class={klasaChipa}>{opcja.etykieta}</label>
                    </span>
                  ))
                }
              </div>
              <p class="mt-2 text-xs text-red-500" data-blad="terrain" hidden></p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-brand-text mb-2" for="pole-termin">
                  Planowany termin realizacji
                </label>
                <select id="pole-termin" name="timeline" data-pole="timeline" class={klasaPola}>
                  {opcjeTerminu.map((opcja) => <option value={opcja.klucz}>{opcja.etykieta}</option>)}
                </select>
                <p class="mt-1 text-xs text-red-500" data-blad="timeline" hidden></p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-brand-text mb-2" for="pole-budzet">
                  Orientacyjny budżet
                </label>
                <select id="pole-budzet" name="budget" data-pole="budget" class={klasaPola}>
                  {
                    opcjeBudzetu.map((opcja) => (
                      <option value={opcja.klucz} selected={opcja.klucz === 'unknown'}>
                        {opcja.etykieta}
                      </option>
                    ))
                  }
                </select>
                <p class="mt-1 text-xs text-red-500" data-blad="budget" hidden></p>
              </div>
            </div>

            <div>
              <div class="flex items-baseline justify-between mb-2">
                <label class="text-xs font-semibold text-brand-text" for="pole-opis">Dodatkowe informacje</label>
                <span class="text-xs tabular-nums text-brand-text-light" data-licznik="description">
                  0 / {limity.description.toLocaleString('pl-PL')}
                </span>
              </div>
              <textarea
                id="pole-opis"
                name="description"
                rows="4"
                data-pole="description"
                data-limit={limity.description}
                aria-describedby="blad-description"
                placeholder="Opisz szczegóły, które nie zostały jeszcze uwzględnione - np. kolor ogrodzenia, materiał, planowane elementy dodatkowe (oświetlenie, przęsła ozdobne, rodzaj słupków), dostępność placu budowy..."
                class={`${klasaPola} resize-none`}></textarea>
              <p class="mt-1 text-xs text-red-500" id="blad-description" data-blad="description" hidden></p>
            </div>

            {/* --- zdjęcia --- */}
            <div>
              <div
                class="rounded-xl border-2 border-dashed p-5 transition-colors border-brand-border bg-brand-section/50 hover:border-brand-olive/30"
                data-upload
              >
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-brand-olive/10 text-brand-olive-text">
                      <Ikona nazwa="upload" rozmiar={18} />
                    </div>
                    <div>
                      <p class="text-sm font-medium text-brand-text">{zdjecia.tytul}</p>
                      <p class="text-xs text-brand-text-light">{zdjecia.opis}</p>
                    </div>
                  </div>

                  <label
                    for="pole-zdjecia"
                    class="px-5 py-2.5 rounded-full font-semibold text-sm transition-colors bg-brand-olive text-brand-dark hover:bg-brand-olive-dark cursor-pointer"
                    data-upload-przycisk
                  >
                    {zdjecia.przycisk}
                  </label>
                  {/* HEIC/HEIF na wejściu: kompresja zamienia je w JPEG
                      (tam, gdzie przeglądarka umie je zdekodować). */}
                  <input
                    id="pole-zdjecia"
                    type="file"
                    name="photos"
                    accept={ZDJECIA.typyWejscia.join(',')}
                    multiple
                    class="poza-ekranem"
                    data-pole="photos"
                    data-upload-pole
                  />
                </div>
              </div>

              <p class="mt-2 text-xs text-red-500" data-blad="photos" hidden></p>
              <div class="mt-2 space-y-1" data-upload-odrzucone aria-live="polite"></div>
              <div class="mt-3 flex flex-wrap gap-2" data-upload-lista></div>
            </div>
          </div>

          {/* ═══ KROK 4 - dane kontaktowe ══════════════════ */}
          <div data-krok="3">
            <h2 class="font-display text-2xl lg:text-3xl font-bold text-brand-text">{etapy[3].tytul}</h2>
            <p class="mt-2 text-sm text-brand-text-light">{etapy[3].opis}</p>
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-brand-text mb-2" for="pole-imie">
                  Imię <span class="text-red-400">*</span>
                </label>
                <input
                  id="pole-imie"
                  name="name"
                  data-pole="name"
                  data-limit={limity.name}
                  required
                  autocomplete="name"
                  aria-describedby="blad-name"
                  placeholder="Twoje imię"
                  class={klasaPola}
                />
                <p class="mt-1 text-xs text-red-500" id="blad-name" data-blad="name" hidden></p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-brand-text mb-2" for="pole-email">
                  E-mail <span class="text-red-400">*</span>
                </label>
                <input
                  id="pole-email"
                  type="email"
                  name="email"
                  data-pole="email"
                  data-limit={limity.email}
                  required
                  autocomplete="email"
                  aria-describedby="blad-email"
                  placeholder="np. jan@domena.pl"
                  class={klasaPola}
                />
                <p class="mt-1 text-xs text-red-500" id="blad-email" data-blad="email" hidden></p>
              </div>
              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-brand-text mb-2" for="pole-telefon">
                  Telefon <span class="text-brand-text-light text-xs">(opcjonalnie)</span>
                </label>
                <input
                  id="pole-telefon"
                  type="tel"
                  name="phone"
                  data-pole="phone"
                  data-limit={limity.phone}
                  autocomplete="tel"
                  aria-describedby="blad-phone podpowiedz-phone"
                  placeholder="+48 xxx xxx xxx"
                  class={klasaPola}
                />
                <p class="mt-1 text-xs text-red-500" id="blad-phone" data-blad="phone" hidden></p>
                <p class="mt-1 text-xs text-brand-text-light" id="podpowiedz-phone" data-podpowiedz="phone">
                  Podanie numeru przyspiesza odpowiedź - oddzwonimy w ciągu 24h.
                </p>
              </div>
            </div>
          </div>

          {/* ═══ KROK 5 - podsumowanie ═════════════════════ */}
          <div data-krok="4">
            <h2 class="font-display text-2xl lg:text-3xl font-bold text-brand-text">{etapy[4].tytul}</h2>
            <p class="mt-2 text-sm text-brand-text-light">{etapy[4].opis}</p>
            <div class="mt-8 bg-brand-card border border-brand-border rounded-2xl overflow-hidden">
              <div class="px-5 py-3 bg-brand-section border-b border-brand-border">
                <span class="text-[10px] tracking-widest font-semibold text-brand-sage uppercase">
                  {podsumowanie.tytul}
                </span>
              </div>
              {
                wierszePodsumowania.map((wiersz) => (
                  <button
                    type="button"
                    data-podsumowanie-wiersz={wiersz.pole}
                    data-krok-docelowy={wiersz.krok}
                    class="w-full flex items-center justify-between gap-4 px-5 py-4 border-t border-brand-border text-left hover:bg-brand-section/50 transition-colors group"
                  >
                    <span class="min-w-0">
                      <span class="block text-[10px] tracking-widest font-semibold text-brand-text-light uppercase">
                        {wiersz.etykieta}
                      </span>
                      <span class="block mt-0.5 text-sm text-brand-text truncate" data-podsumowanie-wartosc>
                        -
                      </span>
                    </span>
                    <Ikona
                      nazwa="chevron-right"
                      rozmiar={16}
                      class="text-brand-text-light shrink-0 group-hover:text-brand-olive-text transition-colors"
                    />
                  </button>
                ))
              }
            </div>
          </div>

          {/* Pułapka na boty (INTEGRATION.md): poza ekranem i ukryta przed
              czytnikami, ale nie `type="hidden"` - takie pola boty pomijają. */}
          <div class="poza-ekranem" aria-hidden="true">
            <label>Nie wypełniaj <input type="text" name={POLE_PULAPKA} tabindex="-1" autocomplete="off" /></label>
          </div>

          <div
            class="mt-6 flex items-start gap-3 px-4 py-3 rounded-xl bg-red-50 border border-red-200"
            data-formularz-blad
            role="alert"
            hidden
          >
            <Ikona nazwa="alert-triangle" rozmiar={18} class="text-red-500 shrink-0 mt-0.5" />
            <div class="min-w-0">
              <p class="text-sm text-red-700" data-formularz-blad-tekst></p>
              <p class="mt-1 text-[11px] text-red-700/80 break-all" data-formularz-kod hidden></p>
            </div>
          </div>

          {/* Klauzula informacyjna, nie zgoda (art. 6 ust. 1 lit. f RODO).
              Widoczna w źródle; skrypt chowa ją na krokach innych niż ostatni. */}
          <p class="mt-6 text-xs text-brand-text-light" data-wycena-rodo>
            {rodo.przed}&nbsp;<a href="/polityka-prywatnosci/" class="text-brand-olive-text underline hover:text-brand-text">{rodo.link}</a>.
          </p>

          <div class="mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200" data-formularz-podsumowanie hidden>
            <div class="flex items-start gap-3">
              <Ikona nazwa="alert-triangle" rozmiar={18} class="text-red-500 shrink-0 mt-0.5" />
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-red-700" data-podsumowanie-tytul></p>
                <ul class="mt-1.5 space-y-0.5" data-podsumowanie-lista></ul>
              </div>
              <button
                type="button"
                data-podsumowanie-zamknij
                class="text-red-400 hover:text-red-600 transition-colors p-1 -mr-1 -mt-1"
              >
                <span class="poza-ekranem">Zamknij</span>
                <Ikona nazwa="x" rozmiar={14} />
              </button>
            </div>
          </div>

          <div class="mt-8 flex flex-row justify-between border-t border-brand-border pt-6">
            <button
              type="button"
              data-wycena-wstecz
              class="inline-flex items-center gap-1 px-5 py-3 rounded-full border text-sm font-semibold transition-all border-brand-border text-brand-text-light/50 cursor-not-allowed"
              disabled
            >
              <Ikona nazwa="arrow-left" rozmiar={16} />
              {przyciski.wstecz}
            </button>

            <button
              type="button"
              data-wycena-dalej
              class="inline-flex items-center gap-1 px-6 py-3 rounded-full text-sm font-semibold transition-all bg-brand-olive text-brand-dark hover:bg-brand-olive-dark hover:shadow-lg hover:shadow-brand-olive/20"
            >
              {przyciski.dalej}
              <Ikona nazwa="arrow-right" rozmiar={16} />
            </button>

            <button
              type="button"
              data-wycena-wyslij
              class="flex items-center gap-1 px-6 py-3 rounded-full text-sm font-semibold transition-all bg-brand-olive text-brand-dark hover:bg-brand-olive-dark hover:shadow-lg hover:shadow-brand-olive/20 disabled:opacity-60 disabled:cursor-not-allowed"
              hidden
            >
              {przyciski.wyslij}
              <Ikona nazwa="send" rozmiar={16} />
            </button>
          </div>
        </form>
      </div>
    </section>
  </div>
</Podstrona>
