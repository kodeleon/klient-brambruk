---
/**
 * /realizacje/ - galeria z filtrem kategorii i szukajką.
 *
 * Odpowiednik `code/src/pages/Realizacje.jsx`. Filtr kategorii działa bez
 * JavaScriptu (ukryte przyciski wyboru + CSS, patrz `zakladki.css`).
 * Szukajka i licznik wymagają skryptu - `src/scripts/filtry.ts` - i bez
 * niego po prostu nie zawężają widoku. Wszystkie kafelki są w HTML.
 */
import Podstrona from '../layouts/Podstrona.astro'
import { wpis } from '../lib/tresc'
import Okruszki from '../components/ui/Okruszki.astro'
import Przycisk from '../components/ui/Przycisk.astro'
import Odslon from '../components/ui/Odslon.astro'
import GaleriaSiatka from '../components/ui/GaleriaSiatka.astro'
import BanerCta from '../components/ui/BanerCta.astro'
import Ikona from '../components/icons/Ikona.astro'
import Foto from '../components/media/Foto.astro'
import SekcjaHero from '../components/ui/SekcjaHero.astro'

const { kategorie, pozycje: realizacje } = await wpis('realizacje', 'realizacje')
const strona = await wpis('strony', 'realizacje')
const { hero, filtr, pusto, baner } = strona

const klasaFiltra =
  'inline-flex px-5 py-2.5 rounded-full text-sm font-semibold border transition-all duration-200 bg-brand-card text-brand-text border-brand-border/60 hover:border-brand-olive/40'
---

<Podstrona
  tytul={strona.meta.tytul}
  opis={strona.meta.opis}
>
  <Okruszki pozycje={[{ etykieta: 'Strona główna', sciezka: '/' }, { etykieta: 'Realizacje' }]} />

  <SekcjaHero
    etykieta={hero.etykieta}
    tytul={hero.tytul}
    podtytul={hero.podtytul}
    opis={hero.opis}
    foto={hero.foto}
  >
    <Fragment slot="akcje">
      <Przycisk href="/wycena/" rozmiar="lg" ikona="receipt-text">Bezpłatna wycena</Przycisk>
      <Przycisk href="/uslugi/" wariant="secondary" rozmiar="lg" ikona="banknote">Nasze usługi</Przycisk>
    </Fragment>

    <Foto
      slot="obok"
      klucz={hero.fotoObok}
      alt={hero.fotoObokAlt}
      class="w-full h-[340px] object-cover rounded-2xl shadow-2xl shadow-black/50"
    />
  </SekcjaHero>

  <section class="tlo-siatka bg-brand-bg py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10" data-filtr>
      {
        kategorie.map((kategoria, i) => (
          <input
            type="radio"
            name="kategoria-realizacji"
            id={`kategoria-${kategoria.klucz}`}
            class="poza-ekranem"
            checked={i === 0}
          />
        ))
      }

      <Odslon>
        <div class="font-display text-base font-bold text-brand-text mb-2">{filtr.tytul}</div>
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-4">
          <div class="flex flex-wrap gap-2 mb-2" role="group" aria-label={filtr.etykietaGrupy}>
            {
              kategorie.map((kategoria) => (
                <label for={`kategoria-${kategoria.klucz}`} class={klasaFiltra}>
                  {kategoria.etykieta}
                </label>
              ))
            }
          </div>
          <div class="relative w-full lg:w-80">
            <Ikona
              nazwa="search"
              rozmiar={16}
              class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-text-light"
            />
            <label class="poza-ekranem" for="szukaj-realizacji">{filtr.etykietaSzukania}</label>
            <input
              id="szukaj-realizacji"
              type="search"
              placeholder={filtr.placeholder}
              data-filtr-szukaj
              class="w-full bg-brand-card border border-brand-border/60 rounded-full pl-11 pr-4 py-3 text-sm text-brand-text placeholder:text-brand-text-light focus:outline-none focus:ring-2 focus:ring-brand-olive/20 focus:border-brand-olive/40 transition-all"
            />
          </div>
        </div>
        <p class="text-xs text-brand-text-light mb-6">
          {filtr.licznikPrzed} <span data-filtr-widoczne>{realizacje.length}</span>{' '}
          {filtr.licznikMiedzy} {realizacje.length} {filtr.licznikPo}
        </p>
      </Odslon>

      <GaleriaSiatka pozycje={realizacje} />

      <div class="text-center py-16" data-filtr-pusto hidden>
        <p class="text-brand-text-light text-sm">{pusto.tekst}</p>
        <button
          type="button"
          data-filtr-wyczysc
          class="mt-3 text-brand-olive-text text-sm font-semibold hover:text-brand-text transition-colors"
        >
          {pusto.przycisk}
        </button>
      </div>
    </div>
  </section>

  <BanerCta tytul={baner.tytul} opis={baner.opis} />
</Podstrona>
