---
/**
 * /realizacje/ - galeria z filtrem kategorii i szukajką.
 *
 * Odpowiednik `code/src/pages/Realizacje.jsx`. Filtr kategorii działa bez
 * JavaScriptu (ukryte przyciski wyboru + CSS, patrz `zakladki.css`).
 * Szukajka i licznik wymagają skryptu - `src/scripts/filtry.ts` - i bez
 * niego po prostu nie zawężają widoku. Wszystkie kafelki są w HTML.
 */
import Podstrona from '../layouts/Podstrona.astro'
import { kategorieRealizacji, realizacje } from '../data/realizacje'
import { statystyki } from '../config/dane'
import Okruszki from '../components/ui/Okruszki.astro'
import EtykietaSekcji from '../components/ui/EtykietaSekcji.astro'
import Przycisk from '../components/ui/Przycisk.astro'
import Odslon from '../components/ui/Odslon.astro'
import GaleriaSiatka from '../components/ui/GaleriaSiatka.astro'
import BanerCta from '../components/ui/BanerCta.astro'
import Ikona from '../components/icons/Ikona.astro'
import Foto from '../components/media/Foto.astro'

const klasaFiltra =
  'inline-flex px-5 py-2.5 rounded-full text-sm font-semibold border transition-all duration-200 bg-brand-card text-brand-text border-brand-border/60 hover:border-brand-olive/40'
---

<Podstrona
  tytul="Realizacje - galeria projektów - BramBruk | Biała Podlaska i okolice"
  opis="Galeria realizacji BramBruk: ogrodzenia, bramy, kostka brukowa, budownictwo. Ponad 100 projektów w Białej Podlaskiej i okolicach."
>
  <Okruszki pozycje={[{ etykieta: 'Strona główna', sciezka: '/' }, { etykieta: 'Realizacje' }]} />

  <section class="relative bg-brand-dark overflow-hidden">
    <div class="absolute inset-0">
      <Foto klucz="realizacja.01" alt="" class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/90 to-brand-dark/60"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <EtykietaSekcji class="mb-3">Portfolio</EtykietaSekcji>
          <h1 class="font-display text-3xl lg:text-[42px] font-bold text-white leading-tight mb-2">
            Nasze realizacje
          </h1>
          <p class="font-display text-xl lg:text-2xl font-semibold text-brand-olive leading-tight mb-6">
            {statystyki.realizacje} projektów w regionie
          </p>
          <p class="text-neutral-400 leading-relaxed max-w-lg mb-8">
            Ogrodzenia, brukarstwo i budownictwo - wybrane realizacje z Białej Podlaskiej i okolic.
            Filtruj według kategorii, aby znaleźć projekty podobne do Twojego.
          </p>
          <div class="flex flex-wrap gap-4">
            <Przycisk href="/wycena/" rozmiar="lg" ikona="receipt-text">Bezpłatna wycena</Przycisk>
            <Przycisk href="/uslugi/" wariant="secondary" rozmiar="lg">Nasze usługi</Przycisk>
          </div>
        </div>
        <div class="hidden lg:block">
          <Foto klucz="realizacja.02" alt="Realizacje BramBruk" class="w-full h-[340px] object-cover rounded-2xl" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-brand-bg py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10" data-filtr>
      {
        kategorieRealizacji.map((kategoria, i) => (
          <input
            type="radio"
            name="kategoria-realizacji"
            id={`kategoria-${kategoria.klucz}`}
            class="poza-ekranem"
            checked={i === 0}
          />
        ))
      }

      <Odslon>
        <div class="font-display text-base font-bold text-brand-text mb-2">Typ usługi:</div>
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-4">
          <div class="flex flex-wrap gap-2 mb-2" role="group" aria-label="Kategoria realizacji">
            {
              kategorieRealizacji.map((kategoria) => (
                <label for={`kategoria-${kategoria.klucz}`} class={klasaFiltra}>
                  {kategoria.etykieta}
                </label>
              ))
            }
          </div>
          <div class="relative w-full lg:w-80">
            <Ikona
              nazwa="search"
              rozmiar={16}
              class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-text-light"
            />
            <label class="poza-ekranem" for="szukaj-realizacji">Szukaj realizacji</label>
            <input
              id="szukaj-realizacji"
              type="search"
              placeholder="Szukaj po typie usługi lub lokalizacji..."
              data-filtr-szukaj
              class="w-full bg-brand-card border border-brand-border/60 rounded-full pl-11 pr-4 py-3 text-sm text-brand-text placeholder:text-brand-text-light focus:outline-none focus:ring-2 focus:ring-brand-olive/20 focus:border-brand-olive/40 transition-all"
            />
          </div>
        </div>
        <p class="text-xs text-brand-text-light mb-6">
          Wyświetlono <span data-filtr-widoczne>{realizacje.length}</span> z {realizacje.length} realizacji
        </p>
      </Odslon>

      <GaleriaSiatka pozycje={realizacje} />

      <div class="text-center py-16" data-filtr-pusto hidden>
        <p class="text-brand-text-light text-sm">Brak realizacji pasujących do wybranych filtrów.</p>
        <button
          type="button"
          data-filtr-wyczysc
          class="mt-3 text-brand-olive text-sm font-semibold hover:text-brand-olive-dark transition-colors"
        >
          Wyczyść filtry
        </button>
      </div>
    </div>
  </section>

  <BanerCta
    tytul="Chcesz podobną realizację?"
    podtytul="Opisz swój projekt - wycenimy go w ciągu 24 godzin, bezpłatnie"
  >
    <Przycisk slot="akcja" href="/wycena/" rozmiar="lg" ikona="receipt-text">Bezpłatna wycena</Przycisk>
  </BanerCta>
</Podstrona>
