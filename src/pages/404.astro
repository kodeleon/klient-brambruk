---
/**
 * STRONA BŁĘDU 404.
 *
 * Odpowiednik `Placeholder.jsx`, którego stary router pokazywał pod
 * nieznanym adresem. Różnica: tamten renderował się ze statusem 200
 * (SPA nie potrafi inaczej), tutaj Cloudflare oddaje ten dokument
 * z kodem 404 - ustawia to `not_found_handling: "404-page"` w `wrangler.jsonc`.
 *
 * `kanoniczny={false}` jest konieczne: dokument jest serwowany pod KAŻDYM
 * nieistniejącym adresem, a nie pod `/404/`.
 */
import Podstrona from '../layouts/Podstrona.astro'
import Przycisk from '../components/ui/Przycisk.astro'
import Ikona from '../components/icons/Ikona.astro'
import nawigacja from '../content/nawigacja.json'
import { trasa } from '../config/routes'
import { wpis } from '../lib/tresc'

const strona = await wpis('strony', '404')
---

<Podstrona
  tytul={strona.meta.tytul}
  opis={strona.meta.opis}
  noindex
  kanoniczny={false}
>
  <section class="bg-brand-section py-24 lg:py-40">
    <div class="max-w-2xl mx-auto px-5 text-center">
      <div class="w-20 h-20 rounded-2xl bg-brand-olive/10 flex items-center justify-center mx-auto mb-6">
        <Ikona nazwa="construction" rozmiar={36} class="text-brand-olive-text" />
      </div>
      <h1 class="font-display text-3xl font-bold text-brand-text mb-3">{strona.tytul}</h1>
      <p class="text-brand-text-light mb-8 leading-relaxed">
        {
          strona.opis.map((wiersz, i) => (
            <>
              {i > 0 && <br />}
              {wiersz}
            </>
          ))
        }
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Przycisk href={trasa('wycena')} ikona="receipt-text">{strona.przyciski.wycena}</Przycisk>
        <Przycisk href={trasa('glowna')} wariant="outline" ikona="home">{strona.przyciski.glowna}</Przycisk>
      </div>

      <nav class="mt-10" aria-label={strona.nawigacja.etykieta}>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
          {
            nawigacja.glowna.map((pozycja) => (
              <li>
                <a href={trasa(pozycja.trasa)} class="text-brand-sage font-medium hover:underline">
                  {pozycja.etykieta}
                </a>
              </li>
            ))
          }
          <li>
            <a href={trasa('polityka-prywatnosci')} class="text-brand-sage font-medium hover:underline">
              {strona.nawigacja.polityka}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </section>
</Podstrona>
