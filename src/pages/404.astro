---
/**
 * STRONA BŁĘDU 404.
 *
 * Odpowiednik `Placeholder.jsx`, którego stary router pokazywał pod
 * nieznanym adresem. Różnica: tamten renderował się ze statusem 200
 * (SPA nie potrafi inaczej), tutaj Cloudflare oddaje ten dokument
 * z kodem 404 - ustawia to `not_found_handling: "404-page"` w `wrangler.jsonc`.
 *
 * `kanoniczny={false}` jest konieczne: dokument jest serwowany pod KAŻDYM
 * nieistniejącym adresem, a nie pod `/404/`.
 */
import Podstrona from '../layouts/Podstrona.astro'
import Przycisk from '../components/ui/Przycisk.astro'
import Ikona from '../components/icons/Ikona.astro'
import { nawigacja } from '../config/dane'
---

<Podstrona
  tytul="Strona nie znaleziona - BramBruk"
  opis="Pod tym adresem nic nie ma. Poniżej jest wszystko, czego zwykle się tutaj szuka."
  noindex
  kanoniczny={false}
>
  <section class="bg-brand-section py-24 lg:py-40">
    <div class="max-w-2xl mx-auto px-5 text-center">
      <div class="w-20 h-20 rounded-2xl bg-brand-olive/10 flex items-center justify-center mx-auto mb-6">
        <Ikona nazwa="construction" rozmiar={36} class="text-brand-olive" />
      </div>
      <h1 class="font-display text-3xl font-bold text-brand-text mb-3">Strona nie znaleziona</h1>
      <p class="text-brand-text-light mb-8 leading-relaxed">
        Adres mógł się zmienić albo zawiera literówkę.
        <br />
        Tymczasem zapraszamy do kontaktu lub skorzystania z bezpłatnej wyceny.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Przycisk href="/wycena/" ikona="receipt-text">Bezpłatna wycena</Przycisk>
        <Przycisk href="/" wariant="secondary" ikona="home">Strona główna</Przycisk>
      </div>

      <nav class="mt-10" aria-label="Pozostałe podstrony">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
          {
            nawigacja.map((pozycja) => (
              <li>
                <a href={pozycja.sciezka} class="text-brand-sage font-medium hover:underline">
                  {pozycja.etykieta}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/polityka-prywatnosci/" class="text-brand-sage font-medium hover:underline">
              Polityka prywatności
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </section>
</Podstrona>
