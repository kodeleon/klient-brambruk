---
/**
 * /uslugi/ - przegląd wszystkich usług z widełkami cenowymi.
 *
 * ┌── ZAKŁADKI ZAMIENIONE NA KOTWICE ──────────────────────────────────┐
 * │ Wcześniej trzy zakładki przełączały widoczne karty: w dokumencie    │
 * │ były wszystkie, ale CSS pokazywał jedną trzecią naraz. Kosztowało   │
 * │ to dwie rzeczy naraz:                                               │
 * │   · odwiedzający nie widział pełnej oferty bez klikania - a to JEST │
 * │     podstrona oferty, jej zadaniem jest pokazać, ile tego jest,     │
 * │   · nie dało się podlinkować konkretnego zakresu.                   │
 * │                                                                     │
 * │ Teraz wszystkie karty są widoczne, pogrupowane po typie, a przyciski│
 * │ typu przewijają do grupy (`#ogrodzenia`, `#brukarstwo`,             │
 * │ `#budownictwo`). Zero JavaScriptu, zero stanu, adres do wysłania    │
 * │ klientowi. Przy okazji zniknął `zakladki.css`.                      │
 * │                                                                     │
 * │ Kotwice nie chowają się pod przyklejonym nagłówkiem - `base.css`    │
 * │ ma `scroll-padding-top` liczone z `--naglowek-wysokosc`.            │
 * └─────────────────────────────────────────────────────────────────────┘
 */
import Podstrona from "../layouts/Podstrona.astro";
import { kartyUslug } from "../data/cennik";
import Okruszki from "../components/ui/Okruszki.astro";
import EtykietaSekcji from "../components/ui/EtykietaSekcji.astro";
import Przycisk from "../components/ui/Przycisk.astro";
import Odslon from "../components/ui/Odslon.astro";
import KartaUslugi from "../components/ui/KartaUslugi.astro";
import BanerCta from "../components/ui/BanerCta.astro";
import Foto from "../components/media/Foto.astro";
import SekcjaHero from "../components/ui/SekcjaHero.astro";
import Ikona from "../components/icons/Ikona.astro";

const grupy = [
  {
    klucz: "ogrodzenia",
    ikona: "fence",
    przycisk: "ogrodzeniach",
    etykieta: "Ogrodzenia i bramy",
    podstrona: "/ogrodzenia/",
  },
  {
    klucz: "brukarstwo",
    ikona: "pavement",
    przycisk: "brukarstwie",
    etykieta: "Brukarstwo",
    podstrona: "/brukarstwo/",
  },
  {
    klucz: "budownictwo",
    ikona: "brick-wall",
    przycisk: "budownictwie",
    etykieta: "Budownictwo",
    podstrona: "/budownictwo/",
  },
] as const;
---

<Podstrona
  tytul="Usługi i cennik - BramBruk | Biała Podlaska i okolice"
  opis="Pełna oferta i cennik BramBruk: ogrodzenia panelowe i murowane, bramy, furtki, kostka brukowa, podjazdy, budownictwo. Biała Podlaska i okolice."
>
  <Okruszki
    pozycje={[
      { etykieta: "Strona główna", sciezka: "/" },
      { etykieta: "Usługi i cennik" },
    ]}
  />

  <SekcjaHero
    etykieta="Usługi i cennik"
    tytul="Zakres usług BramBruk"
    podtytul="Orientacyjne widełki cenowe"
    opis="Poniżej znajdziesz przegląd wszystkich usług wraz z orientacyjnymi cenami. Dokładna wycena zawsze zależy od zakresu, materiałów i lokalizacji - opisz swój projekt w formularzu."
    foto="hero.ogrodzenia"
  >
    <Fragment slot="akcje">
      <Przycisk href="/wycena/" rozmiar="lg" ikona="receipt-text"
        >Bezpłatna wycena</Przycisk
      >
      <Przycisk
        href="/realizacje/"
        wariant="secondary"
        rozmiar="lg"
        ikona="images">Nasze realizacje</Przycisk
      >
    </Fragment>

    {
      /* Typy usług są jednocześnie spisem treści podstrony i skrótem do
        właściwej grupy. Bez chevronów: to odnośniki do miejsca niżej
        na stronie, a nie przyciski czegoś, co się rozwija. */
    }
    <nav slot="dodatek" class="mt-8" aria-label="Przejdź do typu usługi">
      <p
        class="text-[10px] font-bold uppercase tracking-[2px] text-neutral-400 mb-3"
      >
        Typ usługi
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          grupy.map((grupa) => (
            <li>
              <a
                href={`#${grupa.klucz}`}
                class="inline-flex items-center rounded-full border border-white/20 px-4 py-2 gap-2 text-sm font-semibold text-brand-text-xlight transition-colors hover:border-brand-olive hover:text-brand-olive"
              >
                <Ikona nazwa={grupa.ikona} rozmiar={14} class="shrink-0" />
                {grupa.etykieta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Foto
      slot="obok"
      klucz="hero.uslugi-obok"
      class="w-full h-[340px] object-cover rounded-2xl shadow-2xl shadow-black/50"
    />
  </SekcjaHero>

  <section id="main-content" class="tlo-siatka bg-brand-bg py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <div
        class="mb-10 px-3 py-4 rounded-xl bg-brand-section border border-brand-border/60 text-sm text-brand-text-light"
      >
        <div class="font-display text-base font-bold text-brand-text pb-1">
          Uwaga!
        </div>
        Ceny są wyłącznie orientacyjne i nie stanowią oferty sprzedażowej. Ostateczna
        kwota zależy od zakresu prac, użytych materiałów i specyfiki terenu.
        <div class="mt-2"></div>
        <a href="/wycena/" class="text-brand-sage font-medium hover:underline"
          >Zapytaj o dokładną wycenę →</a
        >
      </div>

      {
        grupy.map((grupa, indeks) => (
          <div
            id={grupa.klucz}
            class:list={["scroll-mt-24", indeks > 0 && "mt-14 lg:mt-20"]}
          >
            {/* Nazwa typu i przycisk do jego podstrony stoją w jednym
                wierszu, po przeciwnych stronach - ten sam układ, co przy
                „Zobacz wszystkie realizacje" na pozostałych podstronach. */}
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-6">
              <div>
                <EtykietaSekcji>Co oferujemy</EtykietaSekcji>
                <h2 class="font-display text-2xl lg:text-3xl font-bold text-brand-text mt-2">
                  {grupa.etykieta}
                </h2>
              </div>
              {/* Opis grupy stał tu wcześniej jednym zdaniem i powtarzał
                  to, co widać w kartach pod nim - dwa razy to samo, raz
                  prozą, raz konkretem. Zostaje konkret. */}
              <Przycisk
                href={grupa.podstrona}
                wariant="outline"
                rozmiar="sm"
                ikona={grupa.ikona}
                class="self-start sm:self-end shrink-0"
              >
                Szczegóły o {grupa.przycisk}
              </Przycisk>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {kartyUslug[grupa.klucz].map((karta, i) => (
                <Odslon wariant="up" zwloka={i * 60}>
                  <KartaUslugi
                    tytul={karta.tytul}
                    opis={karta.opis}
                    foto={karta.foto}
                    href={karta.href}
                  >
                    {/* Odznaka ceny: pełna oliwka z ciemnym napisem (9,22:1).
                        Wcześniej był to oliwkowy napis na przyciemnionym
                        zdjęciu - czyli kontrast zależny od tego, co akurat
                        jest pod spodem, a więc niepoliczalny. */}
                    <div
                      slot="odznaka"
                      class="absolute top-3 right-3 z-10 rounded-lg bg-brand-olive px-3 py-1.5 text-right shadow-md shadow-black/20"
                    >
                      <span class="block text-sm font-bold leading-tight text-brand-dark">
                        {karta.cena}
                      </span>
                      {karta.nota && (
                        <span class="block text-[11px] leading-tight text-brand-dark/80">
                          {karta.nota}
                        </span>
                      )}
                    </div>
                  </KartaUslugi>
                </Odslon>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <BanerCta
    tytul="Widełki to nie wycena. Potrzebujesz konkretów?"
    opis="Ceny wyżej pokazują rząd wielkości. Dokładna kwota zależy od wymiarów, terenu i materiału - opisz projekt, a policzymy go dla Twojej posesji."
  />
</Podstrona>
