# Lokalne zmienne dla `wrangler dev`. Skopiuj do .dev.vars (plik ignorowany przez git):
#   cp .dev.vars.example .dev.vars
# Wartości tutaj nadpisują "vars" z wrangler.jsonc i zastępują sekrety
# (`secrets.required`). Inne klucze wrangler pomija.

# Sekret: klucz API Resend. Pusty = działa tylko tryb MAIL_DRY_RUN=true.
RESEND_API_KEY=

# Sekret: odbiorcy zgłoszeń (po przecinku). Wymagany także w dry run -
# bez niego worker odpowiada 500 not_configured. Do prawdziwej wysyłki
# wpisz własny adres, nigdy adres firmy.
MAIL_TO=odbiorca@example.com

# Originy produkcyjne + lokalna strona testowa (npm run dev:page) i Astro
# (npm run dev / npm run preview na porcie 4321).
ALLOWED_ORIGINS=https://brambruk.pl,https://www.brambruk.pl,http://localhost:4321,http://127.0.0.1:4321

# DECYZJA: lokalnie domyślnie bez wysyłki. Do prawdziwego testu: klucz powyżej,
# MAIL_DRY_RUN=false i MAIL_TO ustawione na własny adres.
MAIL_DRY_RUN=true
