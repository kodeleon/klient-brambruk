px;line-height:24px;color:#2c2c2c;font-weight:800;margin:0 0 12px;\">Podsumowanie zapytania</div><div style=\"font-size:15px;line-height:20px;color:#2c2c2c;font-weight:600;margin-bottom:8px;\">Twoje dane:</div><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;\"><tr><td style=\"color:#5a5a5a;width:160px;padding:5px 0;\">Imię:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{name}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">E-mail:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{email}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Telefon:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{phone}}</strong></td></tr></table><div style=\"height:14px;\"></div><div style=\"font-size:15px;line-height:20px;color:#2c2c2c;font-weight:600;margin-bottom:8px;\">Szczegóły projektu:</div><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;\"><tr><td style=\"color:#5a5a5a;width:160px;padding:5px 0;\">Typ usługi:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{serviceType}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Rodzaj:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{subtype}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Wymiary:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{amount}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Lokalizacja:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{location}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Termin:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{timeline}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Budżet:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{budget}}</strong></td></tr><tr><td style