{
  "slug": "wycena",
  "name": "Formularz wyceny",
  "settings": {
    "block_links": true
  },
  "fields": [
    {
      "name": "serviceType",
      "type": "select",
      "required": true,
      "label": "Usługa",
      "default": "—",
      "options": [
        {
          "key": "ogrodzenia",
          "label": "Ogrodzenie / brama"
        },
        {
          "key": "brukarstwo",
          "label": "Kostka brukowa"
        },
        {
          "key": "budownictwo",
          "label": "Budownictwo lekkie"
        }
      ]
    },
    {
      "name": "subtype",
      "type": "select",
      "required": false,
      "label": "Rodzaj",
      "default": "—",
      "options": [
        {
          "key": "panelowe",
          "label": "Panelowe 2D/3D"
        },
        {
          "key": "murowane",
          "label": "Murowane / podmurówki"
        },
        {
          "key": "brama-przesuwna",
          "label": "Brama przesuwna"
        },
        {
          "key": "brama-dwuskrzydlowa",
          "label": "Brama dwuskrzydłowa"
        },
        {
          "key": "furtka",
          "label": "Furtka"
        },
        {
          "key": "siatka",
          "label": "Siatka ogrodzeniowa"
        },
        {
          "key": "inne-ogrodzenia",
          "label": "Inne / nie wiem"
        },
        {
          "key": "podjazd",
          "label": "Podjazd"
        },
        {
          "key": "chodnik",
          "label": "Chodnik / alejka"
        },
        {
          "key": "taras",
          "label": "Taras"
        },
        {
          "key": "parking",
          "label": "Parking"
        },
        {
          "key": "schody",
          "label": "Schody terenowe"
        },
        {
          "key": "inne-brukarstwo",
          "label": "Inne / nie wiem"
        },
        {
          "key": "altana",
          "label": "Altana ogrodowa"
        },
        {
          "key": "garaz",
          "label": "Garaż"
        },
        {
          "key": "domek",
          "label": "Domek narzędziowy"
        },
        {
          "key": "wiata",
          "label": "Wiata"
        },
        {
          "key": "inne-budownictwo",
          "label": "Inne"
        }
      ]
    },
    {
      "name": "amount",
      "type": "text",
      "required": false,
      "label": "Wymiary",
      "maxlength": 50,
      "default": "—"
    },
    {
      "name": "location",
      "type": "text",
      "required": false,
      "label": "Lokalizacja",
      "maxlength": 200,
      "default": "—"
    },
    {
      "name": "terrain",
      "type": "multiselect",
      "required": false,
      "label": "Utrudnienia terenu",
      "default": "Brak",
      "options": [
        {
          "key": "flat",
          "label": "Teren płaski"
        },
        {
          "key": "uneven",
          "label": "Lekkie nierówności"
        },
        {
          "key": "slope",
          "label": "Spadek / pochyłość"
        },
        {
          "key": "access",
          "label": "Utrudniony dojazd"
        },
        {
          "key": "old-fence",
          "label": "Stare ogrodzenie do rozbiórki"
        },
        {
          "key": "leveling",
          "label": "Wyrównanie terenu"
        },
        {
          "key": "rocky",
          "label": "Kamienisty / twardy grunt"
        },
        {
          "key": "wet",
          "label": "Podmokły / wysoki poziom wód"
        },
        {
          "key": "roots",
          "label": "Korzenie drzew / pnie"
        },
        {
          "key": "narrow",
          "label": "Wąski dojazd maszyn"
        },
        {
          "key": "neighbor",
          "label": "Granica z sąsiadem"
        }
      ]
    },
    {
      "name": "timeline",
      "type": "select",
      "required": false,
      "label": "Planowany termin",
      "default": "—",
      "options": [
        {
          "key": "asap",
          "label": "Jak najszybciej"
        },
        {
          "key": "month",
          "label": "W ciągu miesiąca"
        },
        {
          "key": "quarter",
          "label": "W ciągu 3 miesięcy"
        },
        {
          "key": "later",
          "label": "Później / do ustalenia"
        }
      ]
    },
    {
      "name": "budget",
      "type": "select",
      "required": false,
      "label": "Orientacyjny budżet",
      "default": "—",
      "options": [
        {
          "key": "up_to_5k",
          "label": "do 5 000 zł"
        },
        {
          "key": "5k_15k",
          "label": "5 000 – 15 000 zł"
        },
        {
          "key": "15k_30k",
          "label": "15 000 – 30 000 zł"
        },
        {
          "key": "over_30k",
          "label": "powyżej 30 000 zł"
        },
        {
          "key": "unknown",
          "label": "Nie wiem jeszcze"
        }
      ]
    },
    {
      "name": "description",
      "type": "textarea",
      "required": false,
      "label": "Opis projektu",
      "maxlength": 5000,
      "default": "—"
    },
    {
      "name": "photos",
      "type": "file",
      "required": false,
      "label": "Zdjęcia",
      "default": "Brak",
      "max_files": 5,
      "max_size_mb": 5,
      "allowed_types": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ]
    },
    {
      "name": "name",
      "type": "text",
      "required": true,
      "label": "Imię",
      "maxlength": 100
    },
    {
      "name": "email",
      "type": "email",
      "required": true,
      "label": "Email",
      "maxlength": 200
    },
    {
      "name": "phone",
      "type": "tel",
      "required": false,
      "label": "Telefon",
      "maxlength": 20,
      "default": "—"
    }
  ],
  "recipients": {
    "mode": "single",
    "admin_emails": [
      "kontakt@brambruk.pl"
    ]
  },
  "templates": {
