yle=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;\"><tr><td style=\"color:#5a5a5a;width:140px;padding:5px 0;\">Imię:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{name}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">E-mail:</td><td style=\"padding:5px 4px;\"><a href=\"mailto:{{email}}\" style=\"color:#89a66f;text-decoration:underline;\">{{email}}</a></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Telefon:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{phone}}</strong></td></tr></table></td></tr></table></td></tr><!-- SZCZEGÓŁY PROJEKTU --><tr><td style=\"padding:0 22px 14px 22px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f8f9f7;border:1px solid #ececec;border-radius:14px;\"><tr><td style=\"padding:16px;font-family:Arial,Helvetica,sans-serif;\"><div style=\"font-size:17px;line-height:24px;color:#2c2c2c;font-weight:800;margin:0 0 12px;\">Szczegóły projektu</div><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;\"><tr><td style=\"color:#5a5a5a;width:160px;padding:5px 0;\">Typ usługi:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{serviceType}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Rodzaj:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{subtype}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Wymiary:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{amount}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Lokalizacja:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{location}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Teren:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{terrain}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Termin:</td><td style=\"color:#2c2c2c;p