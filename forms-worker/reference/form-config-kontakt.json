{
    "slug": "contact",
    "name": "Formularz kontaktowy",
    "settings": {
        "block_links": true
    },
    "fields": [
        {
            "name": "name",
            "type": "text",
            "required": true,
            "label": "Imię",
            "maxlength": 100
        },
        {
            "name": "email",
            "type": "email",
            "required": true,
            "label": "Email",
            "maxlength": 200
        },
        {
            "name": "phone",
            "type": "tel",
            "required": false,
            "label": "Nr. telefonu",
            "maxlength": 12,
            "default": "—"
        },
        {
            "name": "message",
            "type": "textarea",
            "required": true,
            "label": "Wiadomość",
            "maxlength": 2000
        }
    ],
    "recipients": {
        "mode": "single",
        "admin_emails": [
            "kontakt@brambruk.pl"
        ]
    },
    "templates": {
        "admin": {
            "enabled": true,
            "subject": "Nowe zapytanie od {{name}}",
            "body": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Nowe zapytanie kontaktowe</title></head><body style=\"background:#e8e8e8;padding:20px;\"><!-- PREHEADER --><div style=\"display:none;font-size:1px;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;mso-hide:all;\">Nowe zapytanie kontaktowe od {{name}} ({{email}}).</div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0;padding:0;border-collapse:collapse;\"><tr><td align=\"center\" style=\"padding:28px 12px;\"><table role=\"presentation\" width=\"640\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:640px;max-width:640px;background:#ffffff;border:1px solid #ececec;border-radius:16px;overflow:hidden;border-collapse:separate;\"><!-- TOP BAR --><tr><td style=\"background:#98af15;padding:14px 18px;font-family:Arial,Helvetica,sans-serif;\"><div style=\"font-size:15px;line-height:20px;color:#ffffff;font-weight:700;letter-spacing:0.2px;\">Nowe zapytanie kontaktowe</div></td></tr><!-- HEADER --><tr><td style=\"padding:22px 22px 14px;font-family:Arial,Helvetica,sans-serif;\"><div style=\"font-size:24px;line-height:30px;color:#5a5343;font-weight:800;\">Nowe zapytanie kontaktowe</div><div style=\"height:8px;\"></div><div style=\"font-size:15px;line-height:22px;color:#5a5a5a;\">Na stronie <a href=\"https://brambruk.pl\" style=\"color:#89a66f;text-decoration:underline;\">brambruk.pl</a> zostało przesłane zapytanie przez formularz kontaktowy.</div></td></tr><!-- DANE NADAWCY --><tr><td style=\"padding:0 22px 14px 22px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f8f9f7;border:1px solid #ececec;border-radius:14px;\"><tr><td style=\"padding:16px;font-family:Arial,Helvetica,sans-serif;\"><div style=\"font-size:17px;line-height:24px;color:#2c2c2c;font-weight:800;margin:0 0 12px;\">Dane nadawcy</div><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;\"><tr><td style=\"color:#5a5a5a;width:140px;padding:5px 0;\">Imię:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{name}}</strong></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">E-mail:</td><td style=\"padding:5px 4px;\"><a href=\"mailto:{{email}}\" style=\"color:#89a66f;text-decoration:underline;\">{{email}}</a></td></tr><tr><td style=\"color:#5a5a5a;padding:5px 0;\">Telefon:</td><td style=\"color:#2c2c2c;padding:5px 4px;\"><strong>{{phone}}</strong></td></tr></table></td></tr></table></td></tr><!-- WIADOMOŚĆ --><tr><td style=\"padding:0 22px 18px 22px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f8f9f7;border:1px solid #ececec;border-radius:14px;\"><tr><td style=\"padding:16px;font-family:Arial,Helvetica,sans-serif;\"><div style=\"font-size:17px;line-height:24px;color:#2c2c2c;font-weight:800;margin:0 0 12px;\">Treść wiadomości</div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffffff;border:1px solid #ececec;border-left:6px solid #b5cc1c;border-radius:12px;\"><tr><td style=\"padding:14px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#2c2c2c;\"><div style=\"white-space:pre-line;word-break:break-word;overflow-wrap:anywhere;margin:0;\">{{message}}</div></td></tr></table></td></tr></table></td></tr><!-- FOOTER --><tr><td style=\"background:#5a5343;padding:18px 22px;font-family:Arial,Helvetica,sans-serif;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tr><td align=\"left\" style=\"vertical-align:top;padding-right:10px;width:74px;\"><a href=\"https://brambruk.pl\" style=\"text-decoration:none;border:0;display:inline-block;\"><img src=\"https://brambruk.pl/wp-content/uploads/2025/10/logo-mim-256.png\